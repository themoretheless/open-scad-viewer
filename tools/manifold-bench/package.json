{
  "name": "open-scad-viewer-manifold-bench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Sidecar Manifold comparison benches. Not part of the product runtime.",
  "scripts": {
    "bench:cpu": "node bench-cpu.mjs",
    "bench:memory": "node --expose-gc bench-memory.mjs",
    "bench:kernel:record": "node rbench-regression.mjs record",
    "bench:kernel:check": "node rbench-regression.mjs check",
    "test:rbench": "node --test rbench-regression.test.mjs",
    "test:differential": "node differential.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "manifold-3d": "3.5.1"
  }
}
