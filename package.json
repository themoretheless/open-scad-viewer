{
  "name": "open-scad-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && node scripts/verify-dist.mjs",
    "mcp": "node --import tsx src/mcp/server.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.mcp.json",
    "test": "vitest run",
    "test:gcode": "npm run build:geometry && cargo test --locked --manifest-path crates/Cargo.toml -p gcode-core -p slicer-core && cargo test --locked --manifest-path crates/Cargo.toml -p geometry-bridge --test gcode && vitest run tests/meshToolpathHostApi.test.ts tests/gcodePreviewWorker.test.ts tests/gcodePanel.test.ts",
    "test:conformance": "vitest run tests/languageConformance.test.ts",
    "test:official": "npm run verify:openscad-runtime && vitest run tests/officialOpenScadRuntimeConformance.test.ts tests/mcpOfficialRuntimeStdio.test.ts",
    "test:scale": "vitest run tests/scaleTargets.test.ts",
    "bench:cpu": "node scripts/bench-cpu.mjs",
    "bench:workers": "node --import tsx benchmarks/worker-lifecycle.mts",
    "bench:readiness": "node --import tsx benchmarks/provider-readiness.mts",
    "bench:nurbs-process": "node --import tsx benchmarks/nurbs-process.mts",
    "bench:bootstrap": "node benchmarks/wasm-bootstrap.mjs",
    "bench:profiles": "node scripts/bench-profile-triangulation.mjs",
    "bench:analysis": "node --import tsx benchmarks/solid-analysis.mts",
    "bench:exact-solid-browser": "node benchmarks/exact-solid-browser.mjs",
    "bench:brep-validation": "cargo run --release --locked --manifest-path crates/Cargo.toml -p brep-core --example bench_validation",
    "bench:brep-decode": "cargo run --release --locked --manifest-path crates/Cargo.toml -p brep-core --example bench_decode",
    "bench:brep-dispatch": "cargo run --release --locked --manifest-path crates/Cargo.toml -p geometry-bridge --example bench_brep_dispatch",
    "bench:gpu": "node scripts/bench-gpu.mjs",
    "bench:webgpu-variants": "node tools/browser-qualification/webgpu-variants-benchmark.mjs",
    "bench:memory": "node --expose-gc --import tsx benchmarks/cad-memory.mjs",
    "setup:openscad": "node --import tsx scripts/official-openscad-runtime.mjs install",
    "verify:openscad-runtime": "node --import tsx scripts/official-openscad-runtime.mjs verify",
    "status:openscad-runtime": "node --import tsx scripts/official-openscad-runtime.mjs status",
    "verify:dist": "node scripts/verify-dist.mjs",
    "audit:bundle": "vite build --sourcemap && node scripts/audit-bundle.mjs",
    "test:bundle-audit": "node --test tests/auditBundle.test.mjs",
    "test:worker-packaging": "node tools/browser-qualification/worker-packaging.mjs",
    "audit:wasm-package": "node scripts/audit-wasm-package.mjs",
    "test:wasm-package": "node --test tests/auditWasmPackage.test.mjs",
    "test:wasm-optimize": "node --test tests/wasmOptimize.test.mjs tests/wasmOptCache.test.mjs",
    "audit:qualification-drift": "node scripts/audit-qualification-drift.mjs",
    "test:qualification-drift": "node --test tests/qualificationDriftAudit.test.mjs",
    "check": "npm run typecheck && npm run test && npm run build",
    "predev": "npm run build:geometry",
    "prebuild": "npm run build:geometry",
    "pretest": "npm run build:geometry",
    "pretypecheck": "npm run build:geometry",
    "premcp": "npm run build:geometry",
    "build:geometry": "node scripts/build-geometry-kernels.mjs && node scripts/build-language-kernel.mjs && node scripts/build-photogrammetry.mjs && node scripts/pack-harfbuzz.mjs",
    "test:geometry": "npm run build:geometry && cargo test --locked --manifest-path crates/Cargo.toml --workspace && vitest run tests/nurbsCurve.test.ts tests/nurbsSurface.test.ts tests/nurbsTessellation.test.ts tests/modelGraphNurbs.test.ts tests/modelGraphNurbsMcp.test.ts tests/geometryInterop.test.ts",
    "build:photogrammetry": "node scripts/build-photogrammetry.mjs",
    "build:cuda-kernels": "node scripts/build-cuda-kernels.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.4",
    "@modelcontextprotocol/server": "2.0.0",
    "harfbuzzjs": "0.10.3",
    "tsx": "^4.23.13",
    "vue": "^3.5.42",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^6.0.8",
    "@webgpu/types": "^0.1.72",
    "ajv": "^8.20.0",
    "binaryen": "116.0.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
