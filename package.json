{
  "name": "open-scad-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && node scripts/verify-dist.mjs",
    "mcp": "node --import tsx src/mcp/server.ts",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.mcp.json",
    "test": "vitest run",
    "test:conformance": "vitest run tests/languageConformance.test.ts",
    "test:official": "npm run verify:openscad-runtime && vitest run tests/officialOpenScadRuntimeConformance.test.ts tests/mcpOfficialRuntimeStdio.test.ts",
    "test:scale": "vitest run tests/scaleTargets.test.ts",
    "bench:cpu": "node scripts/bench-cpu.mjs",
    "bench:gpu": "node scripts/bench-gpu.mjs",
    "bench:memory": "node --expose-gc --import tsx benchmarks/manifold-memory.mjs",
    "setup:openscad": "node --import tsx scripts/official-openscad-runtime.mjs install",
    "verify:openscad-runtime": "node --import tsx scripts/official-openscad-runtime.mjs verify",
    "status:openscad-runtime": "node --import tsx scripts/official-openscad-runtime.mjs status",
    "verify:dist": "node scripts/verify-dist.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.2",
    "@modelcontextprotocol/server": "2.0.0",
    "harfbuzzjs": "0.10.3",
    "manifold-3d": "^3.5.1",
    "tsx": "^4.23.1",
    "vue": "^3.5.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@vitejs/plugin-vue": "^6.0.7",
    "@webgpu/types": "^0.1.60",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^6.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.6"
  }
}
