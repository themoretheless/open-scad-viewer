<script setup lang="ts">
import {useTransientNotice} from './composables/useTransientNotice'
import FormaRegion from './components/FormaRegion.svt'
import topbarUi from './ui/Topbar.ui?raw'
import editorToolbarUi from './ui/EditorToolbar.ui?raw'
import editorStatsUi from './ui/EditorStats.ui?raw'
import viewerToolbarUi from './ui/ViewerToolbar.ui?raw'
import selectionModesUi from './ui/SelectionModes.ui?raw'
import dockRailUi from './ui/DockRail.ui?raw'
import computeInspectorUi from './ui/ComputeInspector.ui?raw'
import statusbarUi from './ui/Statusbar.ui?raw'
import SweepEvidenceStatus from './components/SweepEvidenceStatus.svt'
import PerformancePanel from './components/PerformancePanel.svt'
import ParameterSuggestions from './components/ParameterSuggestions.svt'
import GroupSourcePanel from './components/GroupSourcePanel.svt'
import ExportDialog from './components/ExportDialog.svt'
import { useBuildAndRendererLifecycle, type SweepViewportProgressSnapshot } from './composables/useBuildAndRendererLifecycle'
import { useCodeEditorViewport } from './composables/useCodeEditorViewport'
import { useEditorFormatting } from './composables/useEditorFormatting'
import { useEditorResize } from './composables/useEditorResize'
import { useParameterPresets } from './composables/useParameterPresets'
import { useSectionPlaneControls } from './composables/useSectionPlaneControls'
import { useSourceProvenanceCaret } from './composables/useSourceProvenanceCaret'
import { useViewportDisplayControls } from './composables/useViewportDisplayControls'
import { useWorkspaceFileActions } from './composables/useWorkspaceFileActions'
import { useWorkspacePersistenceLifecycle } from './composables/useWorkspacePersistenceLifecycle'
import { useWorkspaceModes } from './composables/useWorkspaceModes'
import { useMainSourceHistory } from './composables/useMainSourceHistory'
import { useCustomizerSource, useGeometryAnalysis } from './composables/useSourceInspection'
import { useCommandDispatch, usePaletteCommands, type MainToolsHandle } from './composables/useAppCommands'
import { useShellActions } from './composables/useShellActions'
import VrControls from './components/VrControls.svt'
import ModelingGridControls from './components/ModelingGridControls.svt'
import MaterialControls from './features/MaterialControls.svt'
import { clamp } from './kernel/geometry/math3d'
import { isRushFrontend, SOURCE_FILE_ACCEPT, sourceFileExtension } from './language/rushFrontendDetect'
import { computed, defineAsyncComponent, nextTick, onMounted, onUnmounted, ref, shallowRef, watch } from 'svet'
import { MESH_IMPORT_ACCEPT } from './exchange/meshFormats'
import CommandPalette from './components/CommandPalette.svt'
import CustomizerPanel from './components/CustomizerPanel.svt'
const ExampleGallery = defineAsyncComponent(() => import('./components/ExampleGallery.svt'))
const MechanicalGenerator = defineAsyncComponent(() => import('./features/MechanicalGenerator.svt'))
import { BOX_DEFAULTS, generateBox } from './app/boxGenerator'
import { BUSHING_DEFAULTS, generateBushing } from './app/bushingGenerator'
import { SPINNER_DEFAULTS, SPINNER_SAFE_DEFAULTS, generateSpinner, generateSpinnerSafe } from './app/spinnerGenerator'
import { translate, type TranslateParams } from './i18n/appStrings'
import { useAppearance } from './composables/useAppearance'
import { useEditorFind } from './composables/useEditorFind'
import { WORKSPACE_MODES, workspaceModeHint, workspaceModeLabel } from './app/workspaceModes'
const DirectModeler = defineAsyncComponent(() => import('./features/DirectModeler.svt'))
const MeshModeler = defineAsyncComponent(() => import('./features/MeshModeler.svt'))
const MainModelingTools = defineAsyncComponent(() => import('./features/MainModelingTools.svt'))
const ScanPlanePanel = defineAsyncComponent(() => import('./features/ScanPlanePanel.svt'))
const SvgPanel = defineAsyncComponent(() => import('./features/SvgPanel.svt'))
const PhotogrammetryPanel = defineAsyncComponent(() => import('./features/PhotogrammetryPanel.svt'))
const InspectPanel = defineAsyncComponent(() => import('./components/InspectPanel.svt'))
const SceneOutliner = defineAsyncComponent(() => import('./components/SceneOutliner.svt'))
const KeyboardShortcuts = defineAsyncComponent(() => import('./components/KeyboardShortcuts.svt'))
import ViewCube from './components/ViewCube.svt'
import type { GeometryQuality } from './core/build'
import { type MeshData } from './core/mesh'
import { MAX_PARAMETER_PRESETS } from './app/parameterPresets'
import { EXAMPLE_CATALOG, EXAMPLES } from './data/examples'
import { assertExampleCatalog } from './app/exampleCatalog'
import { buildShortcutHelpGroups } from './app/commandRegistry'
import { backendQuality } from './render/backendQuality'
import { clampEditorWidth, editorWidthBounds } from './app/layoutSizing'
import { SceneController } from './app/sceneController'
import { ViewportController } from './render/viewportController'
import { revealDiagnostic, type EditorDiagnostic } from './language/editorDiagnostics'
import { setStorageFailureHandler, storageGet, storageSet } from './core/safeStorage'
import { geometryExportEligibility } from './app/buildPromotionPolicy'
import { MAX_WORKSPACE_SOURCE_LENGTH, updateWorkspaceDocument, type WorkspaceDocumentSnapshot } from './app/workspaceDocument'
import type { BrowserWorkspacePersistence } from './app/workspacePersistence'
import { assertThemeCatalog, THEME_CATALOG } from './app/themePreferences'
import type { PickHit } from './render/rendererContracts'
import { blockColors, dockTabs, DOCK_ICONS, revealDockDetails, closeMenus, closeMenusOutside, type DockTab } from './appHelpers'

assertExampleCatalog(EXAMPLE_CATALOG)
assertThemeCatalog(THEME_CATALOG)

const props = defineProps<{
  initialWorkspace: WorkspaceDocumentSnapshot
  initialWorkspaceDurable: boolean
  initialSharedImportPending: boolean
  workspacePersistence: BrowserWorkspacePersistence
}>()

const {
  lang, themeSelection, customAccent, customBase, effectiveTokens, isDark, setCustomColor, effectiveCanvasColor, resetCustomColors, toggleLang, toggleTheme,
  applyPreferences, attachSystemTheme, detachSystemTheme
} = useAppearance({
  onApplied(canvasColor) {
    getRenderer()?.setBackgroundColor(canvasColor)
    // Re-apply the render theme so its backgroundColor (when set) stays authoritative.
    getRenderer()?.setTheme(renderThemeId.value)
  },
})
const workspaceDocument = ref<WorkspaceDocumentSnapshot>(props.initialWorkspace)
const code = ref(props.initialWorkspace.source)
const autoRender = ref(storageGet('scad-auto') !== 'false')
const editorWidth = ref(clamp(Number(storageGet('scad-editor-width')) || 440, 300, 820))

const canvasRef = ref<HTMLCanvasElement | null>(null)
const editorRef = ref<HTMLTextAreaElement | null>(null)
const highlightRef = ref<HTMLPreElement | null>(null)
const selectedEditorName = ref('')
const {
  foldedLines, highlightedCode, foldedRows, lineNumbersRef, guidesRef, editorLineCount, guideRowPx, visibleGutterRows, visibleGuideRows, gutterLinesHeight, toggleFold,
  editFoldedLine, syncHighlightScroll
} = useCodeEditorViewport({
  code, selectedEditorName, editorRef, highlightRef
})
watch(code, () => { foldedLines.value = new Set(); void nextTick(syncHighlightScroll) }, { flush: 'post' })
const findInputRef = ref<HTMLInputElement | null>(null)
const mainRef = ref<HTMLElement | null>(null)
const error = ref('')
const editorDiagnostic = ref<EditorDiagnostic | null>(null)
const warnings = ref<string[]>([])
const meshCount = ref(0)
const triangleCount = ref(0)
const volume = ref(0)
const surfaceArea = ref(0)
const renderDuration = ref(0)
const gpuOk = ref(false)
const rendererInitializing = ref(false)
const rendererUnavailableMessage = ref('')
const currentBackendQuality = computed(() => backendQuality(gpuOk.value, displayMode.value))
const rendering = ref(false)
const renderingQuality = ref<GeometryQuality>('full')
const renderedQuality = ref<GeometryQuality>('full')
const renderedSource = ref('')
const notice = ref('')
const showNotice=useTransientNotice(notice)
const fileName = ref(props.initialWorkspace.fileName)
const exampleGalleryOpen = ref(false)
let componentActive = true
const t = (key: string, params?: TranslateParams) => translate(lang.value, key, params)
const formatNumber = (value: number, digits = 0) => value.toLocaleString(lang.value, { maximumFractionDigits: digits })

const persistence = useWorkspacePersistenceLifecycle({
  initialWorkspaceDurable: props.initialWorkspaceDurable, initialSharedImportPending: props.initialSharedImportPending, workspacePersistence: props.workspacePersistence,
  workspaceDocument, code, fileName, lang, exampleGalleryOpen, getRenderer: () => getRenderer(), isComponentActive: () => componentActive,
  markFitNextRender: () => markFitNextRender(), showNotice, translate: t
})
const {
  workspacePersistenceStatus, workspaceConflict, savingBrowser, storageFailureDetail, persistenceLabel, bumpWorkspaceEditGeneration, isRestoringWorkspace,
  isSharedImportPending, applySourceChange, applyFileNameChange, markDocumentReplaced, scheduleWorkspacePersistence, flushWorkspacePersistence, handleVisibilityChange,
  retryWorkspacePersistence, saveBrowserDraft, resolveWorkspaceConflict, reportStorageFailure, updateBeforeUnloadGuard, detachBeforeUnloadGuard,
  disposeWorkspacePersistenceTimer
} = persistence
const FunctionReference = defineAsyncComponent(() => import('./components/FunctionReference.svt'))
const functionReferenceOpen = ref(false)
const functionReferenceQuery = ref('')
const functionReferenceButton = ref<HTMLButtonElement | null>(null)
const mechanicalGeneratorOpen = ref(false)
const {
  directModelerOpen, meshModelerOpen, solidSeedDocument, meshSeedDocument, editorOpen, workspaceMode, solidBuilding, solidAppendBodies, groupEdit, cancelSolidBuild,
  openGroupEditor, openWorkspaceMode, buildSolidGroup, buildSolidFromSource, bringCodeToMesh, bringCodeToSolid, openMeshFromSolid, meshToSolid, continueMainEditInSolid
} = useWorkspaceModes({ code, fileName, lang, error, sceneMeshes: () => sceneMeshes.value })
// Incremented to ask the Solid workspace to open its own command palette.
const solidPaletteRequest = ref(0)
const meshPaletteRequest = ref(0)
function openCommandPalette() {
  if (directModelerOpen.value) solidPaletteRequest.value++
  else if (meshModelerOpen.value) meshPaletteRequest.value++
  else paletteOpen.value = true
}
const solidGpuActive=ref(false)
// The source editor and its own model preview share the workspace.
const sourceViewportVisible = computed(() =>
  !functionReferenceOpen.value && (editorOpen.value || (!directModelerOpen.value && !meshModelerOpen.value)))
watch(sourceViewportVisible, async visible => {
  if (!visible) {
    destroySourceViewportRenderer()
    return
  }
  await nextTick()
  const activeRenderer = getRenderer()
  if (!activeRenderer) await initializeViewportRenderer()
  else activeRenderer.resize()
})
const mainCameraRevision=ref(0)
const mainSelectedIndices=ref<number[]>([])
const mainShiftSelection=ref(false)
const mainProject=(point:readonly number[])=>getRenderer()?.projectWorldPoint(point)??null
const mainRay=(x:number,y:number)=>getRenderer()?.worldRay(x,y)??null
const sweepViewportProgress=ref<SweepViewportProgressSnapshot|null>(null)
const { mainEditPast, mainEditFuture, commitMainSource, appendMainPrimitive, undoMainGeometry } = useMainSourceHistory({
  code, fileName, lang, error, notice, selectedIndex: () => selectedMesh.value, previewMainGeometry: meshes => previewMainGeometry(meshes),
  setMainEditSelection: selection => setMainEditSelection(selection), replaceSource: source => replacePresetSource(source), renderFull: () => doRender('full'),
})

const viewportController = new ViewportController()
const viewportState = shallowRef(viewportController.state)
viewportController.subscribe(state => { viewportState.value = state })
const sceneController = new SceneController<PickHit>()
const sceneState = shallowRef(sceneController.state)
sceneController.subscribe(state => { sceneState.value = state })
const selectedMesh = computed({
  get: () => sceneState.value.selectedIndex,
  set: (selectedIndex: number | null) => { sceneController.update({ selectedIndex }) },
})
const selectedHit = computed({
  get: () => sceneState.value.selectedHit,
  set: (selectedHit: PickHit | null) => { sceneController.update({ selectedHit }) },
})
const hoveredHit = computed(() => sceneState.value.hoveredHit)
const isolated = computed({
  get: () => sceneState.value.isolated,
  set: (isolated: boolean) => { sceneController.update({ isolated }) },
})
const paletteOpen = ref(false)
const shortcutHelpOpen = ref(false)
const canPreviousView = computed(() => viewportState.value.canGoBack)
const sceneMeshes = computed({
  get: () => sceneState.value.meshes,
  set: (meshes: MeshData[]) => { sceneController.update({ meshes }) },
})
const meshVisibility = computed({
  get: () => sceneState.value.visibility,
  set: (visibility: boolean[]) => { sceneController.update({ visibility }) },
})
const measurement = computed(() => sceneState.value.measurement)
const measureActive = computed(() => sceneState.value.measureActive)
const dockTab = ref<DockTab>('scene')
const dockOpen = ref(true)
const viewport = useViewportDisplayControls({
  viewportController, viewportState, sceneController, sceneState, sceneMeshes, meshVisibility, selectedMesh, selectedHit, hoveredHit, isolated, measurement,
  measureActive, renderedSource, code, surfaceArea, volume, mainCameraRevision, dockOpen, dockTab, getRenderer: () => getRenderer(), showNotice, translate: t
})
const {
  projection, gridVisible, gridStep, standardView, activeView, cameraYaw, cameraPitch, displayMode, shadingModel, matcapId, envId, shadowsEnabled, renderThemeId,
  defaultBaseColor, defaultMetallic, defaultRoughness, selectionMode, sceneRows, selectedSceneMeshId, hoveredMesh, currentInspection, panelMeasurement, fitView,
  resetView, previousView, syncCameraState, focusSelection, clearSelection, toggleIsolate, toggleProjection, toggleGrid, changeStandardView, setStandardView,
  setDisplayMode, setShadingModel, setRenderTheme, defaultMaterialState, setDefaultBaseColor, setDefaultMetallic, setDefaultRoughness, setMatcap, setEnv, setShadows,
  applyMaterialPreset, setSelectionMode, selectSceneMesh, setSceneMeshVisibility, preselectSceneMesh, focusSceneMesh, isolateSceneMesh, startMeasure, cancelMeasure,
  clearMeasurement, copyMeasurement
} = viewport
watch(gridStep, step => getRenderer()?.setGridStep(step))
const section = useSectionPlaneControls({
  gpuOk, sceneMeshes, meshVisibility, isolated, selectedMesh, sceneState, sceneController, getRenderer: () => getRenderer()
})
const {
  sectionEnabled, sectionAxis, sectionOffset, sectionFlip, scanPanelOpen, scanToggleRef, sectionRange, sectionAvailable, applySection, syncSectionRange,
  setSectionEnabled, setSectionAxis, setSectionOffset, setSectionFlip, resetSection, closeScanPanel
} = section
// Direct-modeling actions of the Code viewport are reached through the command palette.
const mainToolsRef = ref<MainToolsHandle | null>(null)
const find = useEditorFind({
  code, editor: editorRef, input: findInputRef,
  translate: key => t(key), notify: message => showNotice(message), onEdited: () => handleEditorInput(),
})
const {
  findOpen, replaceOpen, findQuery, findReplacement, findCaseSensitive, activeFindIndex, findResult, findStatus, openEditorFind, closeEditorFind, navigateFind,
  handleFindKeydown, replaceCurrentFindMatch, replaceAllFindMatches
} = find
const editorMaxWidth = ref(820)
const { computeResult, computeBusy, computeError, cancelGeometryAnalysis, runGeometryAnalysis } = useGeometryAnalysis({ code, lang, selectedMesh, sceneMeshes, canExport: () => canExport.value })
const { compactControls, customizerParameters, editorParameterSuggestions } = useCustomizerSource(code)
const {
  presetName, presetSelection, presetError, presetUndo, parameterPresets, selectedPreset, presetCompatible, saveParameterPreset, replacePresetSource,
  restoreParameterPreset, undoParameterPreset, removeParameterPreset, updateCustomizer, updateCustomizerBatch
} = useParameterPresets({
  code, editorRef, workspaceDocument, lang, customizerParameters, bumpWorkspaceEditGeneration, scheduleWorkspacePersistence
})

const stale = computed(() => renderedSource.value !== '' && (renderedSource.value !== code.value || renderedQuality.value === 'preview'))
const sourceMatchesEditor = computed(() => renderedSource.value !== '' && renderedSource.value === code.value)
const exportEligibility = computed(() => geometryExportEligibility({
  meshCount: sceneMeshes.value.length,
  rendering: rendering.value,
  hasError: Boolean(error.value),
  renderedQuality: renderedQuality.value,
  renderedSource: renderedSource.value,
  currentSource: code.value,
}))
const canExport = computed(() => exportEligibility.value.allowed)
const {
  syncSourceHighlightFromEditor, highlightSource, revealSource
} = useSourceProvenanceCaret({
  code, editorRef, selectedEditorName, sceneMeshes, sourceMatchesEditor, getRenderer: () => getRenderer(), showNotice, translate: t
})
const build = useBuildAndRendererLifecycle({
  canvasRef, code, lang, autoRender, sourceViewportVisible, viewportController, sceneController, sceneMeshes, meshVisibility, selectedMesh, selectedHit, isolated,
  measurement, measureActive, displayMode, shadingModel, matcapId, envId, shadowsEnabled, renderThemeId, selectionMode, gridVisible, gridStep, error, editorDiagnostic,
  warnings, meshCount, triangleCount, volume, surfaceArea, renderDuration, rendering, renderingQuality, renderedQuality, renderedSource, gpuOk, rendererInitializing,
  rendererUnavailableMessage, mainSelectedIndices, mainShiftSelection, sweepViewportProgress, defaultMaterialState, effectiveCanvasColor, applySection, syncSectionRange,
  syncSourceHighlightFromEditor, syncCameraState, isComponentActive: () => componentActive, showNotice, translate: t
})
const {
  getRenderer, performanceSamples, performanceLast, performanceMs, performanceRows, buildCounters, markFitNextRender, advanceBuildGeneration, setMainEditSelection,
  mainSelectMany, previewMainGeometry, clearSweepViewportPreview, scheduleRender, cancelAutoBuild, beginParameterGesture, endParameterGesture, commitParameterControl,
  initializeViewportRenderer, destroySourceViewportRenderer, disposeRendererAndBuildCoordinator, startBuildCoordinator, doRender, cancelGeometryBuild
} = build
watch(code, clearSweepViewportPreview, { flush: 'sync' })
const files = useWorkspaceFileActions({
  code, fileName, error, canExport, sceneMeshes, buildCounters, performanceSamples, markFitNextRender, showNotice, translate: t
})
const {
  fileInputRef, convertInputRef, exportDialogOpen, additionalExportFormat, exportMeshQuality, conversionPending, conversionProgress, conversionOperation,
  cancelConversion, openExportDialog, confirmExport, triggerOpen, openSelectedFile, handleDrop, triggerConvert, convertSelectedFile, saveSource, exportStl,
  exportPerformance, exportObj, shareSource
} = files
const conversionStatus = computed(() => {
  const progress = conversionProgress.value
  if (!progress) return ''
  const labels: Record<string, [string, string]> = {
    decode: ['Разбор файла', 'Decoding file'],
    finalize: ['Сборка меша', 'Building indexed mesh'],
    check: ['Проверка manifold', 'Checking manifold topology'],
    repair: ['Исправление топологии', 'Repairing topology'],
    verify: ['Повторная проверка', 'Verifying the result'],
    inspect: ['Анализ меша', 'Inspecting mesh'],
    export: ['Экспорт файла', 'Exporting file'],
  }
  const label = labels[progress.phase] ?? ['Конвертация', 'Converting']
  return `${label[lang.value === 'ru' ? 0 : 1]} · ${progress.completed}/${progress.total}`
})
const statusText = computed(() => rendering.value
  ? t('compiling')
  : error.value ? t('failed') : stale.value ? t('stale') : t('ready'))
const palette = usePaletteCommands({
  t, sceneMeshes, meshVisibility, selectedMesh, isolated, rendering, measureActive, canExport: () => canExport.value, canPreviousView, editorOpen,
  mainTools: () => mainToolsRef.value, viewport, section,
})
const { paletteCommands, visiblePaletteCommands } = palette
const { executeCommand, dispatchKeyboardCommand, handleViewportKey, handleGlobalKey } = useCommandDispatch({
  palette, paletteOpen, shortcutHelpOpen, mainTools: () => mainToolsRef.value, openCommandPalette, renderFull: () => doRender('full'), toggleTheme, dockOpen,
  measureActive, selectedMesh, meshVisibility, viewport, section, files, openEditorFind, openFunctionReferenceFromCommand,
  blockingSurfaceOpen: () => exampleGalleryOpen.value || mechanicalGeneratorOpen.value || functionReferenceOpen.value,
})
const { dockToggleRef, closeDock, handleShellAction, handleShellBinding } = useShellActions({
  dockTab, dockOpen, editorOpen, autoRender, viewport, openWorkspaceMode, saveSource, resolveWorkspaceConflict, retryWorkspacePersistence, openCommandPalette,
  openExportDialog, renderFull: () => doRender('full'), cancelGeometryBuild, cancelSolidBuild, runGeometryAnalysis, cancelGeometryAnalysis, cancelConversion,
})
const shortcutPlatform = /Mac|iPhone|iPad/.test(navigator.platform) ? 'mac' : 'windows-linux'
const shortcutHelpGroups = computed(() => buildShortcutHelpGroups(key => t(key), shortcutPlatform))

let applyingWorkspaceReplacement = false
const topbarRef = ref<HTMLElement | null>(null)
const topbarHeight = ref(52)
let topbarResizeObserver: ResizeObserver | null = null
let layoutResizeObserver: ResizeObserver | null = null
let editorResizeObserver: ResizeObserver | null = null

onMounted(async () => {
  if (topbarRef.value) {
    const syncTopbarHeight = () => { topbarHeight.value = topbarRef.value!.getBoundingClientRect().height }
    syncTopbarHeight()
    topbarResizeObserver = new ResizeObserver(syncTopbarHeight)
    topbarResizeObserver.observe(topbarRef.value)
  }
  setStorageFailureHandler(reportStorageFailure)
  attachSystemTheme()
  updateBeforeUnloadGuard()
  window.addEventListener('pagehide', flushWorkspacePersistence)
  window.addEventListener('pointerup', endParameterGesture)
  window.addEventListener('pointercancel', endParameterGesture)
  window.addEventListener('blur', endParameterGesture)
  document.addEventListener('visibilitychange', handleVisibilityChange)
  if (mainRef.value) {
    const syncEditorBounds = () => {
      const width = mainRef.value?.getBoundingClientRect().width ?? 0
      const bounds = editorWidthBounds(width)
      editorMaxWidth.value = bounds.max
      editorWidth.value = clampEditorWidth(editorWidth.value, width)
    }
    syncEditorBounds()
    layoutResizeObserver = new ResizeObserver(syncEditorBounds)
    layoutResizeObserver.observe(mainRef.value)
  }
  guideRowPx.value = 1.58 * 0.82 * (parseFloat(getComputedStyle(document.documentElement).fontSize) || 16)
  if (editorRef.value) {
    editorResizeObserver = new ResizeObserver(syncHighlightScroll)
    editorResizeObserver.observe(editorRef.value)
  }
  window.addEventListener('keydown', handleGlobalKey)
  try {
    startBuildCoordinator()
    doRender('full')
  } catch {
    error.value = t('workerError')
  }
  if (sourceViewportVisible.value) await initializeViewportRenderer()
  const generatorQuery = new URLSearchParams(location.search).get('generator')
  const needsSpinnerSafeLoad = fileName.value === 'spinner.r' && (!code.value.includes('param inner_rim') || !code.value.includes('planet_backlash'))
  const needsBushingLoad = fileName.value === 'bushing.scad' && (!code.value.includes('is_tube_mf') || !code.value.includes('max_mf_teeth'))
  if (generatorQuery === 'box' || generatorQuery === 'bushing' || generatorQuery === 'spinner' || generatorQuery === 'spinner_safe' || generatorQuery === 'spinner1' || generatorQuery === 'planetary_spinner' || needsSpinnerSafeLoad || needsBushingLoad) {
    await resolveWorkspaceConflict(true)
    if (generatorQuery === 'box') {
      await loadMechanicalModel(generateBox({ ...BOX_DEFAULTS, print_optimized: false, hook_chamfer: false }), 'box.scad')
    } else if (generatorQuery === 'bushing' || needsBushingLoad) {
      await loadMechanicalModel(generateBushing(BUSHING_DEFAULTS), 'bushing.scad')
      if (generatorQuery === 'bushing') mechanicalGeneratorOpen.value = true
    } else if (generatorQuery === 'spinner1') {
      await loadMechanicalModel(generateSpinner(SPINNER_DEFAULTS), 'spinner.r')
    } else {
      await loadMechanicalModel(generateSpinnerSafe(SPINNER_SAFE_DEFAULTS), 'spinner.r')
    }
    await resolveWorkspaceConflict(true)
  }
})

onUnmounted(() => {
  topbarResizeObserver?.disconnect()
  topbarResizeObserver = null
  cancelSolidBuild()
  cancelGeometryAnalysis()
  layoutResizeObserver?.disconnect()
  layoutResizeObserver = null
  editorResizeObserver?.disconnect()
  editorResizeObserver = null
  disposeWorkspacePersistenceTimer()
  componentActive = false
  setStorageFailureHandler(null)
  disposeRendererAndBuildCoordinator()
  window.removeEventListener('keydown', handleGlobalKey)
  detachSystemTheme()
  window.removeEventListener('pagehide', flushWorkspacePersistence)
  window.removeEventListener('pointerup', endParameterGesture)
  window.removeEventListener('pointercancel', endParameterGesture)
  window.removeEventListener('blur', endParameterGesture)
  detachBeforeUnloadGuard()
  document.removeEventListener('visibilitychange', handleVisibilityChange)
  void props.workspacePersistence.close()
})

watch(code, value => {
  if (applyingWorkspaceReplacement) return
  editorDiagnostic.value = null
  // Persistence revisions are local to one WorkspaceDocument and can move
  // backwards when another document is restored. Geometry jobs instead use a
  // process-local monotonic generation, so old results can never alias a new
  // document that happens to have the same revision number.
  advanceBuildGeneration(performance.now())
  // Provenance belongs to the last compiled source revision. Never retain a
  // reverse highlight while the editor has moved ahead of that revision.
  if (renderedSource.value !== value) getRenderer()?.setSourceHighlight(null)
  // A #code= hash left by shareSource() goes stale when code diverges. An
  // imported hash that is still the only durable copy is retained until the
  // replacement draft reaches IDB or the synchronous recovery journal.
  if (!isSharedImportPending() && location.hash.startsWith('#code=')) {
    history.replaceState(null, '', location.pathname + location.search)
  }
  if (isRestoringWorkspace()) {
    if (autoRender.value) scheduleRender(0)
    return
  }
  if (!applySourceChange(value)) return
  if (autoRender.value) scheduleRender()
})

watch(fileName, value => {
  if (applyingWorkspaceReplacement) return
  if (isRestoringWorkspace()) return
  applyFileNameChange(value)
})

watch(autoRender, enabled => {
  storageSet('scad-auto', String(enabled))
  if (enabled) scheduleRender(0)
  else cancelAutoBuild()
})

async function loadEditorDocument(example: string, nextFileName: string) {
  applyingWorkspaceReplacement = true
  advanceBuildGeneration()
  editorDiagnostic.value = null
  getRenderer()?.setSourceHighlight(null)
  if (!isSharedImportPending() && location.hash.startsWith('#code=')) {
    history.replaceState(null, '', location.pathname + location.search)
  }
  workspaceDocument.value = updateWorkspaceDocument(workspaceDocument.value, {
    source: example,
    fileName: nextFileName,
  })
  const editor = editorRef.value
  if (editor) {
    editor.setRangeText(example, 0, editor.value.length, 'start')
    editor.scrollTop = 0
    editor.scrollLeft = 0
    code.value = editor.value
  } else {
    code.value = example
  }
  fileName.value = nextFileName
  markDocumentReplaced()
  if (autoRender.value) scheduleRender()
  markFitNextRender()
  await nextTick()
  applyingWorkspaceReplacement = false
  editor?.focus({ preventScroll: true })
}

async function loadExample(id: string) {
  const example = EXAMPLES[id]
  if (example) await loadEditorDocument(example, `${id}${sourceFileExtension(example)}`)
}

async function loadMechanicalModel(source: string, name: string) {
  groupEdit.value = null
  editorOpen.value = true
  if (name === 'spinner.r' || name === 'bushing.scad') {
    dockOpen.value = true
    dockTab.value = 'params'
  }
  await loadEditorDocument(source, name)
  await doRender('full')
}

function handleEditorInput() {
  editorDiagnostic.value = null
  // The v-model update precedes this handler, so this also clears stale
  // geometry immediately instead of waiting for the next Worker response.
  syncSourceHighlightFromEditor()
}

function revealCurrentDiagnostic() {
  if (editorRef.value && editorDiagnostic.value) revealDiagnostic(editorRef.value, editorDiagnostic.value)
}

function openFunctionReference(query = '') {
  functionReferenceQuery.value = query
  functionReferenceOpen.value = true
}

function openFunctionReferenceFromCommand(paletteWasOpen: boolean) {
  if (paletteWasOpen) functionReferenceButton.value?.focus()
  openFunctionReference(document.activeElement === editorRef.value ? selectedEditorName.value : '')
}

const { formatEditor, handleEditorKey } = useEditorFormatting({ code, editorRef, foldedLines, syncHighlightScroll, handleEditorInput, dispatchKeyboardCommand })

const { startResize, moveResize, stopResize, resizeEditorWithKeyboard } = useEditorResize({ mainRef, editorWidth, editorMaxWidth })

</script>

<template>
  <div class="app" :class="{ 'group-source-open': editorOpen && Boolean(groupEdit) }" :style="{ '--workspace-top': topbarHeight + 'px' }" @dragover.prevent @drop.prevent="handleDrop" @pointerdown.capture="closeMenusOutside">
    <nav ref="topbarRef" class="topbar" aria-label="Application" :inert="functionReferenceOpen">
      <FormaRegion :source="topbarUi" :locale="lang" :state="{ workspaceModeGroupLabel: lang === 'ru' ? 'Режим работы' : 'Workspace mode', workspaceMode, modes: WORKSPACE_MODES.map(m => ({ id: m, label: workspaceModeLabel(m, lang), hint: workspaceModeHint(m, lang) })), workspaceConflict, conflictWarning: `⚠ ${t('storageConflict')}`, exportDraftLabel: t('exportDraft'), useIndexedLabel: t('useIndexed'), restoreDraftLabel: t('restoreDraft'), persistenceError: workspacePersistenceStatus === 'error', persistenceErrorTitle: storageFailureDetail || t('retrySave'), unsavedDraftLabel: `⚠ ${t('unsavedDraft')}`, editorOpen, sourceLabel: lang === 'ru' ? 'Исходный код' : 'Source', commandHelp: t('commandHelp'), commandsLabel: t('commands'), exportTitle: t('exportTitle'), exportLabel: t('export') }" @action="handleShellAction">
        <template #fileMenu>
          <details class="menu file-menu">
            <summary class="file-chip" :title="t('fileMenu')">
              <span class="file-chip-name">{{ fileName }}</span>
              <span v-if="workspaceConflict || workspacePersistenceStatus !== 'saved'" class="file-chip-dot" :class="workspaceConflict ? 'error' : workspacePersistenceStatus" aria-hidden="true" />
              <svg class="chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </summary>
            <div class="menu-list" @click="closeMenus">
              <button type="button" :title="t('openFile')" @click="triggerOpen">{{ t('open') }}</button>
              <button type="button" :title="t('saveFile')" @click="saveSource">{{ t('save') }}</button>
              <button type="button" :disabled="savingBrowser" :title="t('saveBrowserHelp')" @click="saveBrowserDraft">{{ savingBrowser ? t('savingDraft') : t('saveBrowser') }}</button>
              <button type="button" :title="t('shareFile')" @click="shareSource">{{ t('share') }}</button>
              <button type="button" :disabled="conversionPending" :title="t('convertFileHelp')" @click="triggerConvert">{{ t('convertFile') }}</button>
              <span class="menu-status" role="status">{{ persistenceLabel }}</span>
            </div>
          </details>
          <input ref="fileInputRef" class="sr-only" type="file" :accept="SOURCE_FILE_ACCEPT" @change="openSelectedFile">
          <input ref="convertInputRef" class="sr-only" type="file" :accept="MESH_IMPORT_ACCEPT" @change="convertSelectedFile">
        </template>
        <template #generators>
          <button class="btn generators-button" type="button" aria-haspopup="dialog" @click="mechanicalGeneratorOpen = true">{{ t('generators') }}</button>
        </template>
        <template #settingsMenu>
          <details class="menu settings-menu">
            <summary class="icon-btn" :title="t('settings')" :aria-label="t('settings')">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="5" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="12" cy="19" r="1.7"/></svg>
            </summary>
            <div class="menu-list menu-right">
              <div class="menu-row" @click.stop>
                <span>{{ t('theme') }}</span>
                <select v-model="themeSelection" :aria-label="t('theme')" @change="applyPreferences">
                  <option value="system">{{ t('systemTheme') }}</option>
                  <option v-for="theme in THEME_CATALOG" :key="theme.id" :value="theme.id">{{ theme.name[lang] }}</option>
                </select>
              </div>
              <label class="menu-row" @click.stop>
                <span>{{ t('customBase') }}</span>
                <input type="color" :value="customBase ?? effectiveTokens['--bg']" :aria-label="t('customBase')" @input="setCustomColor('base', $event)">
              </label>
              <label class="menu-row" @click.stop>
                <span>{{ t('customAccent') }}</span>
                <input type="color" :value="customAccent ?? effectiveTokens['--accent']" :aria-label="t('customAccent')" @input="setCustomColor('accent', $event)">
              </label>
              <button v-if="customAccent || customBase" type="button" @click.stop="resetCustomColors">{{ t('customReset') }}</button>
              <button type="button" :aria-label="t('language')" @click="toggleLang">
                <span>{{ t('language') }}</span><kbd>{{ lang === 'ru' ? 'RU' : 'EN' }}</kbd>
              </button>
              <button type="button" aria-keyshortcuts="?" aria-haspopup="dialog" @click="closeMenus(); shortcutHelpOpen = true">
                <span>{{ t('shortcuts') }}</span><kbd>?</kbd>
              </button>
            </div>
          </details>
        </template>
      </FormaRegion>
    </nav>

    <main
      ref="mainRef"
      class="main"
      :class="{ 'editor-drawer': editorOpen, 'group-source-drawer': Boolean(groupEdit), 'sweep-source-preview': editorOpen && isRushFrontend(code) && (code.includes('progressive_sweep') || code.includes('miter_sweep')) }"
      :inert="!editorOpen && (directModelerOpen || meshModelerOpen || functionReferenceOpen)"
    >
      <GroupSourcePanel
        v-if="groupEdit" :edit="groupEdit" :width="editorWidth" :lang="lang" :building="solidBuilding" :error="error" :suggestions="editorParameterSuggestions"
        @cancel="cancelSolidBuild(); groupEdit = null" @build="buildSolidGroup" @apply-suggestion="updateCustomizerBatch"
      />
      <section v-else class="editor-panel" :style="{ width: `${editorWidth}px` }" :aria-label="t('editor')">
        <FormaRegion :source="editorToolbarUi" :locale="lang" :state="{ rendering, renderLabel: t('render'), cancelBuildLabel: t('cancelBuild'), autoRender, autoLabel: t('auto'), solidBuilding, cancelSolidLabel: lang === 'ru' ? 'Отмена' : 'Cancel' }" @action="handleShellAction" @binding="handleShellBinding">
          <template #vr>
            <VrControls :meshes="sceneState.meshes" :visibility="sceneState.visibility" :isolated="sceneState.isolated" :selected-index="sceneState.selectedIndex" :locale="lang" />
          </template>
          <template #functionReference>
            <button
              ref="functionReferenceButton"
              class="icon-btn"
              type="button"
              :title="`${t('functionReference')} (F1)`"
              :aria-label="t('functionReference')"
              aria-keyshortcuts="F1"
              aria-haspopup="dialog"
              :aria-expanded="functionReferenceOpen"
              @click="openFunctionReference()"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .8-1 1.5"/><path d="M12 17h.01"/></svg>
            </button>
          </template>
          <template #moreMenu>
            <details class="menu more-menu">
              <summary class="icon-btn" :title="t('more')" :aria-label="t('more')">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="5" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="19" cy="12" r="2"/></svg>
              </summary>
              <div class="menu-list menu-right" @click="closeMenus">
                <button type="button" :disabled="solidBuilding" :title="lang === 'ru' ? 'Собрать точные тела (NURBS) и открыть в Solid' : 'Build exact NURBS solids and open them in Solid'" @click="buildSolidFromSource()">{{ solidBuilding ? '…' : (lang === 'ru' ? 'В Solid' : 'To Solid') }}</button>
                <button type="button" @click="exampleGalleryOpen = true">{{ t('examples') }}</button>
                <button type="button" @click="mechanicalGeneratorOpen = true">{{ t('generators') }}</button>
                <span class="menu-sep" aria-hidden="true" />
                <button type="button" aria-keyshortcuts="Alt+Shift+F" @click="formatEditor">{{ t('format') }} <kbd>Alt Shift F</kbd></button>
                <button type="button" @click="openEditorFind(false)">{{ t('find') }}</button>
                <button type="button" @click="openEditorFind(true)">{{ t('replace') }}</button>
                <button type="button" :disabled="!sceneMeshes.length || rendering" @click="bringCodeToSolid">{{ t('codeToSolid') }}</button>
                <button type="button" :disabled="!sceneMeshes.length || rendering" @click="bringCodeToMesh">{{ t('codeToMesh') }}</button>
              </div>
            </details>
          </template>
        </FormaRegion>

        <div v-if="findOpen" class="find-bar" role="search" @keydown="handleFindKeydown">
          <input
            ref="findInputRef"
            v-model="findQuery"
            type="search"
            autocomplete="off"
            maxlength="4096"
            :aria-label="t('find')"
            :placeholder="t('find')"
          >
          <input
            v-if="replaceOpen"
            v-model="findReplacement"
            type="text"
            autocomplete="off"
            :maxlength="MAX_WORKSPACE_SOURCE_LENGTH"
            :aria-label="t('replace')"
            :placeholder="t('replace')"
          >
          <span class="find-status" role="status" aria-live="polite">{{ findStatus }}</span>
          <button type="button" :aria-label="t('previousMatch')" @click="navigateFind(-1)">↑</button>
          <button type="button" :aria-label="t('nextMatch')" @click="navigateFind(1)">↓</button>
          <label class="find-case"><input v-model="findCaseSensitive" type="checkbox"> {{ t('matchCase') }}</label>
          <button v-if="replaceOpen" type="button" :disabled="activeFindIndex < 0" @click="replaceCurrentFindMatch">{{ t('replace') }}</button>
          <button v-if="replaceOpen" type="button" :disabled="!findResult.matches.length || findResult.truncated" @click="replaceAllFindMatches">{{ t('replaceAll') }}</button>
          <button type="button" :aria-label="t('closeSearch')" @click="closeEditorFind">×</button>
        </div>

        <div class="code-editor" :style="{ '--line-number-digits': Math.max(2, String(editorLineCount).length) }">
        <div v-if="foldedLines.size" class="folded-editor code" aria-label="Свернутый код">
          <div v-for="row in foldedRows" :key="row.line" class="folded-row">
            <span class="folded-number">{{ row.line + 1 }}</span>
            <button v-if="row.block" class="fold-toggle" :aria-label="`${foldedLines.has(row.line) ? 'Развернуть' : 'Свернуть'} блок, строка ${row.line + 1}`" :aria-expanded="!foldedLines.has(row.line)" @click="toggleFold(row.line)">{{ foldedLines.has(row.line) ? '▸' : '▾' }}</button>
            <span v-else class="fold-spacer" />
            <span class="folded-text" @click="editFoldedLine(row.line)"><i v-for="guide in row.guides" :key="guide.start" class="folded-guide" aria-hidden="true" :style="{ left: `${guide.column}ch`, background: guide.last ? `linear-gradient(to bottom, ${blockColors[guide.depth % blockColors.length]} 75%, transparent 100%)` : blockColors[guide.depth % blockColors.length], bottom: '0' }" /><span v-html="row.html || ' '" /><span v-if="row.block && foldedLines.has(row.line)" class="fold-summary"> ⋯ {{ row.block.end - row.line }} строк</span></span>
          </div>
          <button class="unfold-all" @click="editFoldedLine(0)">Развернуть всё для редактирования</button>
        </div>
        <div v-show="!foldedLines.size" class="code-gutter"><div ref="lineNumbersRef" class="gutter-lines" :style="{ height: gutterLinesHeight }"><div v-for="row in visibleGutterRows" :key="row.line" class="gutter-row" :style="{ top: `${row.line * 1.58}em` }"><span aria-hidden="true">{{ row.line + 1 }}</span><button v-if="row.block" class="fold-toggle" :aria-label="`Свернуть блок, строка ${row.line + 1}`" aria-expanded="true" @click="toggleFold(row.line)">▾</button><span v-else class="fold-spacer" /></div></div></div>
        <div v-show="!foldedLines.size" class="code-content">
        <div class="code-guides" aria-hidden="true"><div ref="guidesRef" class="guide-lines" :style="{ height: gutterLinesHeight }"><div v-for="row in visibleGuideRows" :key="row.line" class="guide-row" :style="{ top: `${row.line * 1.58}em` }"><i v-for="guide in row.guides" :key="guide.start" :style="{ left: `${guide.column}ch`, background: guide.last ? `linear-gradient(to bottom, ${blockColors[guide.depth % blockColors.length]} 75%, transparent 100%)` : blockColors[guide.depth % blockColors.length], bottom: '0' }" /></div></div></div>
        <pre ref="highlightRef" class="code code-highlight" aria-hidden="true"><span class="highlight-content" v-html="highlightedCode" /></pre>
        <textarea
          ref="editorRef"
          v-model="code"
          class="code code-input"
          wrap="off"
          @scroll="syncHighlightScroll"
          :aria-label="t('editor')"
          spellcheck="false"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          :maxlength="MAX_WORKSPACE_SOURCE_LENGTH"
          @input="handleEditorInput"
          @select="syncSourceHighlightFromEditor"
          @click="syncSourceHighlightFromEditor"
          @keyup="syncSourceHighlightFromEditor"
          @focus="syncSourceHighlightFromEditor"
          @keydown="handleEditorKey"
        />
        </div>
        </div>

        <ParameterSuggestions :suggestions="editorParameterSuggestions" @apply="updateCustomizerBatch" />
        <div v-if="error" class="message error" role="alert" aria-live="assertive">
          <button v-if="editorDiagnostic" type="button" class="diagnostic-link" @click="revealCurrentDiagnostic">
            {{ error }} · {{ editorDiagnostic.line }}:{{ editorDiagnostic.column }}
          </button>
          <template v-else>{{ error }}</template>
        </div>
        <div v-if="warnings.length" class="message warning" role="status">
          <div v-for="warning in warnings" :key="warning">⚠ {{ warning }}</div>
        </div>

        <FormaRegion :source="editorStatsUi" :locale="lang" :state="{ meshesLabel: t('meshes'), meshesValue: formatNumber(meshCount), trianglesLabel: t('triangles'), trianglesValue: formatNumber(triangleCount), hasMeshes: meshCount > 0, volumeLabel: t('volume'), volumeValue: formatNumber(volume, 2), areaLabel: t('area'), areaValue: formatNumber(surfaceArea, 2), statusClass: ['status', stale ? 'stale' : '', rendering ? 'busy' : '', error ? 'failed' : ''].filter(Boolean).join(' '), statusSummary: `${statusText} · ${formatNumber(renderDuration, 0)} ms` }" />
      </section>

      <div class="splitter" role="separator" tabindex="0" aria-orientation="vertical" :aria-label="t('resize')" :aria-valuenow="Math.round(editorWidth)" aria-valuemin="300" :aria-valuemax="editorMaxWidth" @pointerdown="startResize" @pointermove="moveResize" @pointerup="stopResize" @pointercancel="stopResize" @lostpointercapture="stopResize" @keydown="resizeEditorWithKeyboard"><span /></div>

      <section class="canvas-panel" :class="{ 'with-dock': dockOpen }" :aria-label="t('viewport')" @pointerdown.capture="mainShiftSelection = $event.shiftKey">
        <MainModelingTools ref="mainToolsRef" :project="mainProject" :ray="mainRay" :camera-revision="mainCameraRevision" :selected-indices="mainSelectedIndices" @select-many="mainSelectMany" :meshes="sceneMeshes" :selected="selectedMesh" :hit="selectedHit" :source="code" :ready="!rendering && !stale && renderedSource === code" :locale="lang" :can-undo="!rendering && mainEditPast.at(-1)?.after === code" :can-redo="!rendering && mainEditFuture.at(-1)?.before === code" @append="appendMainPrimitive" @apply="commitMainSource" @solid="continueMainEditInSolid" @preview="previewMainGeometry" @undo="undoMainGeometry()" @redo="undoMainGeometry(true)" />
        <FormaRegion :source="viewerToolbarUi" :locale="lang" :state="{ toolbarClass: dockOpen ? 'viewer-toolbar with-dock' : 'viewer-toolbar', fitLabel: t('fit'), resetLabel: t('reset'), canPreviousView, previousViewLabel: t('previousView'), previousViewTitle: canPreviousView ? `${t('previousView')} · [` : t('noPreviousView'), isOrthographic: projection === 'orthographic', projectionLabel: projection === 'perspective' ? t('perspective') : t('orthographic'), projectionTitle: `${projection === 'perspective' ? t('perspective') : t('orthographic')} → ${projection === 'perspective' ? t('orthographic') : t('perspective')}`, gridVisible, gridLabel: t('grid'), displayLabel: t('display'), displayMode, shadedLabel: t('shaded'), edgesLabel: t('edges'), xrayLabel: t('xray') }" @action="handleShellAction">
          <template #gridAndMaterial>
            <ModelingGridControls :locale="lang" />
            <details class="viewport-material-menu">
              <summary :aria-label="lang === 'ru' ? 'Материал' : 'Material'">{{ lang === 'ru' ? 'Материал' : 'Material' }}</summary>
              <MaterialControls
                :locale="lang"
                :shading-model="shadingModel"
                :theme-id="renderThemeId"
                :base-color="defaultBaseColor"
                :metallic="defaultMetallic"
                :roughness="defaultRoughness"
                :matcap-id="matcapId"
                :env-id="envId"
                :shadows-enabled="shadowsEnabled"
                @update:shading-model="setShadingModel"
                @update:theme-id="setRenderTheme"
                @update:base-color="setDefaultBaseColor"
                @update:metallic="setDefaultMetallic"
                @update:roughness="setDefaultRoughness"
                @update:matcap-id="setMatcap"
                @update:env-id="setEnv"
                @update:shadows-enabled="setShadows"
                @apply-preset="applyMaterialPreset"
              />
            </details>
          </template>
          <template #scanToggle>
            <button
              ref="scanToggleRef" class="view-btn icon-only scan-toggle" type="button"
              :class="{ active: sectionEnabled }" :aria-label="t('section')" :title="t('scanPlane')"
              :aria-expanded="scanPanelOpen" aria-controls="scan-plane-panel"
              :disabled="!sectionAvailable && !sectionEnabled"
              @click="scanPanelOpen = !scanPanelOpen"
            ><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7l8-4 8 4-8 4z"/><path d="M4 7v10l8 4 8-4V7"/><path d="M2 12h20" stroke-dasharray="3 2"/></svg><i v-if="sectionEnabled" class="scan-active-dot" aria-hidden="true" /></button>
          </template>
          <template #standardViewSelect>
            <label class="view-select-label">
              <span class="sr-only">{{ t('view') }}</span>
              <select v-model="standardView" class="view-select" :aria-label="t('view')" @change="changeStandardView">
                <option value="iso">{{ t('iso') }}</option>
                <option value="front">{{ t('front') }}</option>
                <option value="back">{{ t('back') }}</option>
                <option value="left">{{ t('left') }}</option>
                <option value="right">{{ t('right') }}</option>
                <option value="top">{{ t('top') }}</option>
                <option value="bottom">{{ t('bottom') }}</option>
              </select>
            </label>
          </template>
          <template #dockToggle>
            <button ref="dockToggleRef" class="view-btn icon-only" type="button" :aria-label="t('sidebar')" :aria-pressed="dockOpen" :aria-expanded="dockOpen" aria-controls="cad-sidebar" @click="dockOpen = !dockOpen">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M15 4v16"/></svg>
            </button>
          </template>
        </FormaRegion>

        <ScanPlanePanel
          v-if="scanPanelOpen" id="scan-plane-panel"
          :enabled="sectionEnabled" :axis="sectionAxis" :offset="sectionOffset"
          :min="sectionRange.min" :max="sectionRange.max" :step="sectionRange.step"
          :flip="sectionFlip" :locale="lang" :available="sectionAvailable"
          @update:enabled="setSectionEnabled" @update:axis="setSectionAxis"
          @update:offset="setSectionOffset" @update:flip="setSectionFlip"
          @reset="resetSection" @close="closeScanPanel"
        />

        <FormaRegion :source="selectionModesUi" :locale="lang" :state="{ selectionModeLabel: t('selectionMode'), selectionMode, pointLabel: t('point'), pointTitle: `${t('point')} · 1`, faceLabel: t('face'), faceTitle: `${t('face')} · 3`, bodyLabel: t('body'), bodyTitle: `${t('body')} · 4`, showHud: selectedMesh !== null || isolated, hasSelectedMesh: selectedMesh !== null, selectedSummary: selectedMesh !== null ? `${t('selected')}: ${t('object')} ${selectedMesh + 1} / ${meshCount}${(selectedHit?.cycleCount ?? 0) > 1 ? ` · ${t('depthCandidate')} ${(selectedHit?.cycleIndex ?? 0) + 1}/${selectedHit?.cycleCount}` : ''}` : '', isolateLabel: t('isolate'), focusLabel: t('focus'), isolated, isolateTitle: isolated ? t('unisolate') : t('isolate'), deselectLabel: t('deselect') }" @action="handleShellAction" />

        <canvas
          ref="canvasRef"
          class="gpu-canvas"
          role="application"
          tabindex="0"
          :aria-label="t('viewport')"
          @keydown="handleViewportKey"
        />
        <SweepEvidenceStatus :lang="lang" :meshes="sceneMeshes" :current="!rendering && !stale && renderedSource === code" :progress="sweepViewportProgress" :format-number="formatNumber" />
        <div v-if="!gpuOk" class="no-gpu" role="alert"><span>{{ rendererInitializing ? t('initializingViewport') : (rendererUnavailableMessage || t('noGpu')) }}</span><button v-if="!rendererInitializing" class="btn" type="button" @click="initializeViewportRenderer">{{ t('retryRenderer') }}</button></div>
        <div class="view-cube-wrap" :class="{ 'with-dock': dockOpen }"><ViewCube :active-view="activeView" :yaw="cameraYaw" :pitch="cameraPitch" @view="setStandardView" /></div>
        <div v-if="dockOpen" id="cad-sidebar" class="cad-dock">
          <div class="dock-body">
          <div id="dock-panel" class="dock-panel" role="tabpanel" :aria-labelledby="`dock-tab-${dockTab}`">
          <SceneOutliner v-if="dockTab === 'scene'" :meshes="sceneRows" :selected-mesh-id="selectedSceneMeshId" :hovered-mesh-id="hoveredMesh" :locale="lang" :busy="rendering" @select="selectSceneMesh" @clear-selection="clearSelection" @toggle-visibility="setSceneMeshVisibility" @preselect="preselectSceneMesh" @focus="focusSceneMesh" @isolate="isolateSceneMesh" @reveal-source="revealSource" @highlight-source="highlightSource" />
          <div v-else-if="dockTab === 'inspect'" class="compute-inspector">
          <FormaRegion :source="computeInspectorUi" :locale="lang" :state="{ panelTitle: lang === 'ru' ? 'Вычисление геометрии' : 'Geometry computation', canRunCompute: selectedMesh !== null && canExport && !computeBusy, computeButtonLabel: computeBusy ? (lang === 'ru' ? 'Вычисление…' : 'Computing…') : (lang === 'ru' ? 'Рассчитать площадь на GPU' : 'Compute surface area on GPU'), computeBusy, cancelLabel: lang === 'ru' ? 'Отменить' : 'Cancel', description: lang === 'ru' ? 'Выберите деталь актуальной полной сборки. Эксперимент: WebGPU Compute со сверкой каждого результата на CPU.' : 'Select a part from a current full build. Experimental WebGPU Compute with CPU verification of every result.', hasResult: computeResult !== null, areaPrefix: `${lang === 'ru' ? 'Площадь поверхности' : 'Surface area'}: `, areaValue: computeResult ? formatNumber(computeResult.area, 4) : '', backendSummary: computeResult?.backend === 'webgpu-compute' ? 'WebGPU Compute ✓' : (lang === 'ru' ? 'Результат CPU (запасной путь)' : 'CPU result (fallback)'), timingSummary: computeResult ? `CPU: ${formatNumber(computeResult.cpuMs, 1)} ms · GPU: ${computeResult.gpuMs === null ? '—' : formatNumber(computeResult.gpuMs, 1) + ' ms'}` : '', showFallback: Boolean(computeResult?.fallback), fallbackNote: lang === 'ru' ? 'GPU недоступен, завершился с ошибкой или не прошёл сверку. Показан расчёт CPU.' : 'GPU unavailable, failed, or did not pass verification. Showing CPU calculation.', verificationNote: lang === 'ru' ? 'GPU-время включает запуск, передачу и чтение результата. Этот режим проверяет корректность, а не обещает ускорение.' : 'GPU time includes setup, upload and readback. This mode verifies correctness; it does not promise acceleration.', computeError }" @action="handleShellAction" />
          <InspectPanel :selection="currentInspection" :measurement="panelMeasurement" :measure-active="measureActive" :section-enabled="sectionEnabled" :section-axis="sectionAxis" :section-offset="sectionOffset" :section-min="sectionRange.min" :section-max="sectionRange.max" :section-step="sectionRange.step" :section-flip="sectionFlip" :source-reveal-enabled="sourceMatchesEditor" :locale="lang" @start-measure="startMeasure" @cancel-measure="cancelMeasure" @clear-measurement="clearMeasurement" @copy-measurement="copyMeasurement" @reveal-source="revealSource" @update:section-enabled="setSectionEnabled" @update:section-axis="setSectionAxis" @update:section-offset="setSectionOffset" @update:section-flip="setSectionFlip" @reset-section="resetSection" />
          </div>
          <div v-else-if="dockTab === 'svg'" class="dock-scroll" :ref="revealDockDetails">
          <SvgPanel :meshes="sceneMeshes" :hit="selectedHit" :available="canExport" :locale="lang" :can-append="!isRushFrontend(code)" :remaining-source="MAX_WORKSPACE_SOURCE_LENGTH - code.length - 2" :append-revision="workspaceDocument.documentId + ':' + workspaceDocument.mutation" @append="source => { replacePresetSource(code + '\n\n' + source); nextTick(() => doRender('full')) }" />
          </div>
          <div v-else-if="dockTab === 'photo'" class="dock-scroll" :ref="revealDockDetails">
          <PhotogrammetryPanel :locale="lang" :can-append="!isRushFrontend(code)" :remaining-source="MAX_WORKSPACE_SOURCE_LENGTH - code.length - 2" @append="source => replacePresetSource(code + '\n\n' + source)" />
          </div>
          <div v-else-if="dockTab === 'perf'" class="dock-scroll" :ref="revealDockDetails">
          <PerformancePanel :lang="lang" :last="performanceLast" :rows="performanceRows" :counters="buildCounters" :sample-count="performanceSamples.length" :ms="performanceMs" @export="exportPerformance" />
          </div>
          <div v-else class="customizer-card" @pointerdown.capture="beginParameterGesture" @change.capture="commitParameterControl">
            <section class="parameter-presets" :aria-label="lang === 'ru' ? 'Варианты параметров' : 'Parameter presets'">
              <strong>{{ lang === 'ru' ? 'Варианты параметров' : 'Parameter presets' }}</strong>
              <form class="preset-save" @submit.prevent="saveParameterPreset">
                <input v-model="presetName" maxlength="80" :aria-label="lang === 'ru' ? 'Имя варианта' : 'Preset name'" :placeholder="lang === 'ru' ? 'Имя варианта' : 'Preset name'">
                <button type="submit" :disabled="!presetName.trim() || !customizerParameters.length || parameterPresets.length >= MAX_PARAMETER_PRESETS">{{ lang === 'ru' ? 'Сохранить вариант' : 'Save preset' }}</button>
              </form>
              <template v-if="parameterPresets.length">
                <select :value="selectedPreset?.id" :aria-label="lang === 'ru' ? 'Сохранённый вариант' : 'Saved preset'" @change="presetSelection = ($event.target as HTMLSelectElement).value">
                  <option v-for="preset in parameterPresets" :key="preset.id" :value="preset.id">{{ preset.name }}</option>
                </select>
                <div class="preset-actions">
                  <button type="button" :disabled="!presetCompatible" @click="restoreParameterPreset">{{ lang === 'ru' ? 'Применить' : 'Apply' }}</button>
                  <button type="button" @click="removeParameterPreset">{{ lang === 'ru' ? 'Удалить вариант' : 'Delete preset' }}</button>
                  <button v-if="presetUndo && code === presetUndo.after" type="button" @click="undoParameterPreset">{{ lang === 'ru' ? 'Отменить применение' : 'Undo apply' }}</button>
                </div>
                <p v-if="!presetCompatible">{{ lang === 'ru' ? 'Исходник изменился. Вариант доступен после восстановления той же структуры кода, включая комментарии.' : 'Source changed. Restore the same code structure, including comments, to apply this preset.' }}</p>
              </template>
              <p>{{ lang === 'ru' ? 'До 20 вариантов в локальной рабочей сессии. Файл SCAD и ссылка содержат только текущий исходник.' : 'Up to 20 presets in the local workspace. SCAD files and links contain only the current source.' }}</p>
              <p v-if="presetError" role="alert">{{ presetError }}</p>
            </section>
            <CustomizerPanel :parameters="customizerParameters" :errors="compactControls.errors" :title="t('parameters')" :empty-label="t('noParameters')" @change="updateCustomizer" @batch-change="updateCustomizerBatch" />
          </div>
          </div>
          </div>
          <FormaRegion :source="dockRailUi" :locale="lang" :state="{ sidebarLabel: t('sidebar'), dockTab, tabs: dockTabs.map(tab => ({ id: tab, domId: `dock-tab-${tab}`, label: t(tab), iconPath: DOCK_ICONS[tab] })), closeSidebarLabel: t('closeSidebar') }" @action="handleShellAction" />
        </div>
        <div v-if="rendering" class="rendering-badge" role="status"><span class="spinner" />{{ t('compiling') }} · {{ t(renderingQuality) }}</div>
        <div v-else-if="stale" class="stale-badge">{{ t('stale') }}</div>
      </section>
    </main>

    <FormaRegion :source="statusbarUi" :locale="lang" :state="{ statusAriaLabel: lang === 'ru' ? 'Состояние' : 'Status', gpuDotClass: (directModelerOpen ? solidGpuActive : gpuOk) ? 'ok' : 'off', backendLabel: directModelerOpen ? (solidGpuActive ? t('backendWebGpu') : 'CPU · SVG') : (currentBackendQuality.backend === 'webgpu-interactive' ? t('backendWebGpu') : t('backendHeadless')), showSortedTransparency: currentBackendQuality.transparency === 'object-sorted-alpha', transparencySortedLabel: t('transparencySorted'), showPersistence: !directModelerOpen && !meshModelerOpen, persistenceLabel, conversionPending, conversionLabel: conversionStatus || t(conversionOperation === 'export' ? 'exportTitle' : 'convertFile'), conversionMax: conversionProgress?.total ?? (conversionOperation === 'export' ? 2 : 7), conversionValue: conversionProgress?.completed ?? 0, cancelLabel: t('cancel'), hintLabel: t('hint') }" @action="handleShellAction" />

    <ExportDialog
      v-model:format="additionalExportFormat" v-model:quality="exportMeshQuality" :open="exportDialogOpen" :t="t" :can-export="canExport" :conversion-pending="conversionPending"
      :summary="`${fileName} · ${t('meshes')} ${formatNumber(meshCount)} · ${t('triangles')} ${formatNumber(triangleCount)}`"
      @close="exportDialogOpen = false" @convert="triggerConvert" @confirm="confirmExport"
    />

    <div v-if="notice" class="toast" role="status">{{ notice }}</div>
    <CommandPalette :open="paletteOpen" :commands="visiblePaletteCommands" :restore-focus="!shortcutHelpOpen && !functionReferenceOpen" @close="paletteOpen = false" @execute="executeCommand" />
    <DirectModeler
      @backend="solidGpuActive = $event"
      :open="directModelerOpen && (!editorOpen || Boolean(groupEdit))"
      :locale="lang"
      :can-append="!isRushFrontend(code)"
      :remaining-source="MAX_WORKSPACE_SOURCE_LENGTH - code.length - 2"
      :seed-document="solidSeedDocument"
      :append-bodies="solidAppendBodies"
      @edit-group="openGroupEditor"
      :palette-request="solidPaletteRequest"
      @close="directModelerOpen = false; solidSeedDocument = null"
      @to-mesh="openMeshFromSolid"
      @append="source => { replacePresetSource(code + '\n\n' + source); nextTick(() => doRender('full')) }"
    />
    <MeshModeler :open="meshModelerOpen && !editorOpen" :locale="lang" :seed-document="meshSeedDocument" :palette-request="meshPaletteRequest" @close="meshModelerOpen = false" @export-to-solid="meshToSolid" />
    <MechanicalGenerator :open="mechanicalGeneratorOpen" :locale="lang" @close="mechanicalGeneratorOpen = false" @generate="loadMechanicalModel" @download-current="saveSource" />
    <ExampleGallery v-if="exampleGalleryOpen" :open="exampleGalleryOpen" :examples="EXAMPLE_CATALOG" :locale="lang" @close="exampleGalleryOpen = false" @select="loadExample" @download-current="saveSource" />
    <FunctionReference :open="functionReferenceOpen" :locale="lang" :language="isRushFrontend(code) ? 'rush' : 'openscad'" :initial-query="functionReferenceQuery" @close="functionReferenceOpen = false" />
    <KeyboardShortcuts v-if="shortcutHelpOpen" :open="shortcutHelpOpen" :groups="shortcutHelpGroups" :locale="lang" @close="shortcutHelpOpen = false" />
  </div>
</template>

<style src="./styles/app-shell-global.css"></style>

<style src="./styles/app-shell.css"></style>
