<script lang="ts">
import { computed, defineComponent, onBeforeUnmount, type PropType } from 'svet'
import { parseFormaUi, renderFormaAst, syncFormaSignals } from '../forma/runtime'
import { type Signal } from '../forma/svet'
import { isReactive } from '../forma/svet-reactivity'

export default defineComponent({
  name: 'FormaRegion',
  props: {
    source: {
      type: String,
      required: true,
    },
    state: {
      type: Object as PropType<Record<string, unknown>>,
      default: () => ({}),
    },
    locale: {
      type: String,
      default: 'ru',
    },
  },
  emits: {
    action: (_name: string, _args: unknown[], _event?: Event) => true,
    binding: (_path: string, _value: unknown) => true,
  },
  setup(props, { slots, emit }) {
    const ast = computed(() => parseFormaUi(props.source))
    const signals = new Map<string, Signal<unknown>>()
    onBeforeUnmount(() => {
      for (const sig of signals.values()) sig.dispose()
      signals.clear()
    })
    return () => {
      const st = props.state
      if (isReactive(st)) {
        for (const k of Object.keys(st)) {
          const v = st[k]
          if (Array.isArray(v)) void v.length
        }
      }
      syncFormaSignals(signals, st)
      return renderFormaAst(ast.value, st, props.locale, {
        signals,
        slots,
        onAction: (name, args, event) => emit('action', name, args, event),
        onBinding: (path, value) => emit('binding', path, value),
      })
    }
  },
})
</script>
