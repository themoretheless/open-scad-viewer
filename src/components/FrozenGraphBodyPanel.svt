<script setup lang="ts">
import {computed,onUnmounted,ref,shallowRef,watch} from 'svet'
import {createSolidPreviewWorker} from '../kernel/solidPreviewWorker'
import type {FrozenGraphDisplay} from '../kernel/frozenGraphBody'
const props=defineProps<{active:boolean;ru:boolean}>()
const emit=defineEmits<{display:[FrozenGraphDisplay|null];fit:[]}>()
const selectedEdge=defineModel<number|null>('selectedEdge',{default:null})
const label=(ru:string,en:string)=>props.ru?ru:en
const opened=ref(false),segments=ref(8),pending=ref(false),error=ref(''),fileName=ref('')
const artifact=shallowRef<unknown>(),result=shallowRef<FrozenGraphDisplay|null>(null)
const worker=createSolidPreviewWorker();let generation=0
function cancel(){generation++;worker.cancel();pending.value=false;error.value='';result.value=null;selectedEdge.value=null;emit('display',null)}
watch(()=>[props.active,opened.value,segments.value],cancel,{flush:'sync'})
onUnmounted(()=>{cancel();worker.dispose()});defineExpose({cancel})
const canRun=computed(()=>props.active&&opened.value&&!pending.value&&!!artifact.value&&Number.isInteger(segments.value)&&segments.value>=1&&segments.value<=64)
async function run(){
 if(!canRun.value)return
 cancel();const token=generation;pending.value=true
 try{const r=await worker.run({kind:'frozenGraphBodyDisplay',artifact:artifact.value,segments:segments.value,options:{}});if(token!==generation)return;result.value=r;emit('display',r)}
 catch(e){if(token===generation)error.value=label('Не удалось проверить тело. Выберите совместимый файл или уменьшите число отрезков. ','Could not verify this body. Choose a compatible file or reduce the segment count. ')+(e instanceof Error?e.message:String(e))}
 finally{if(token===generation)pending.value=false}
}
async function load(e:Event){
 const input=e.target as HTMLInputElement,file=input.files?.[0];if(!file)return
 cancel();artifact.value=undefined;fileName.value=file.name;const token=generation;pending.value=true
 try{
  if(file.size>16*1024*1024)throw Error(label('Файл слишком большой','File exceeds the input allowance'))
  let stream=file.stream();if(file.name.endsWith('.gz'))stream=stream.pipeThrough(new DecompressionStream('gzip'))
  const reader=stream.getReader(),chunks:Uint8Array[]=[];let size=0
  try{for(;;){const next=await reader.read();if(token!==generation){await reader.cancel();return}if(next.done)break;size+=next.value.byteLength;if(size>16*1024*1024){await reader.cancel();throw Error(label('Распакованный файл слишком большой','Decoded file exceeds the input allowance'))}chunks.push(next.value)}}finally{reader.releaseLock()}
  const bytes=new Uint8Array(size);let at=0;for(const chunk of chunks){bytes.set(chunk,at);at+=chunk.length}
  const parsed:unknown=JSON.parse(new TextDecoder('utf-8',{fatal:true}).decode(bytes));if(token!==generation)return
  artifact.value=parsed;pending.value=false;await run()
 }catch(e){if(token===generation){pending.value=false;error.value=label('Не удалось открыть файл точного тела. ','Could not open the exact-body file. ')+(e instanceof Error?e.message:String(e))}}
 finally{input.value=''}
}
const selected=computed(()=>result.value?.display.edges.find(e=>e.edge===selectedEdge.value))
const originalIds=computed(()=>{
 const links=(result.value?.artifact.geometry as any)?.identityLinks?.edges??[]
 return links.filter((l:any)=>l.edge===selectedEdge.value).map((l:any)=>l.sourceId).join(', ')
})
</script>
<template>
 <details :open="opened" @toggle="opened=($event.target as HTMLDetailsElement).open" data-testid="frozen-graph-body-panel">
  <summary>{{ label('Проверить тело с G2-переходом','Inspect a body with a G2 blend') }}</summary>
  <section v-if="opened" @keydown.esc.stop.prevent="cancel" @keydown.enter.stop.prevent="run">
   <label class="file-open">{{ label('Открыть артефакт тела · JSON / GZ','Open body artifact · JSON / GZ') }}<input type="file" accept=".json,.gz,application/json,application/gzip" :disabled="!active" @change="load"></label>
   <small v-if="fileName">{{ fileName }}</small>
   <label>{{ label('Отрезков на ребро','Segments per edge') }}<input v-model.number="segments" type="number" min="1" max="64" :aria-invalid="!Number.isInteger(segments)||segments<1||segments>64"></label>
   <button type="button" :disabled="!canRun" @click="run">{{ label('Повторить · Enter','Retry · Enter') }}</button>
   <button type="button" :disabled="!pending&&!result&&!error" @click="cancel">{{ label('Отмена · Esc','Cancel · Esc') }}</button>
   <output aria-live="polite">{{ pending?label('Проверка и построение каркаса…','Verifying body and preparing edges…'):error }}</output>
   <template v-if="result">
    <button type="button" @click="emit('fit')">{{ label('Вписать тело','Fit body') }}</button>
    <p>{{ result.report.faces }} {{ label('граней,','faces,') }} {{ result.report.edges }} {{ label('рёбер. Замкнутость подтверждена.','edges. Closure verified.') }}</p>
    <p>{{ label('Кривизна ≤','Curvature ≤') }} {{ result.report.curvatureLimitPerMm }} {{ label('мм⁻¹','/mm') }}</p>
    <label>{{ label('Выбранное ребро','Selected edge') }}<select v-model="selectedEdge"><option :value="null">{{ label('Не выбрано','None') }}</option><option v-for="edge in result.display.edges" :key="edge.edge" :value="edge.edge">{{ edge.edge+1 }}</option></select></label>
    <small v-if="selected">{{ label('Корень: ','Root: ') }}{{ selected.root }}<span v-if="originalIds"> · {{ originalIds }}</span></small>
    <p>{{ label('Каркас — только просмотр. Радиус и толщина ещё не подтверждены; тело не добавляется в модель.','The wireframe is a preview. Radius and thickness remain unqualified; the body is not added to the model.') }}</p>
   </template>
  </section>
 </details>
</template>
<style scoped>
summary{cursor:pointer}label{display:grid;gap:4px;margin:7px 0}small{display:block;overflow-wrap:anywhere}p{font-size:12px}button{margin:6px 4px 6px 0}output{display:block;overflow-wrap:anywhere}
</style>
