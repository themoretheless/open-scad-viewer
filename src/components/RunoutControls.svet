<script setup lang="ts">
import {computed} from 'svet'
import CadQuantityInput from './CadQuantityInput.svet'
import type {DirectDocument} from '../services/directModeling'
import type {G2RunoutReport} from '../services/geometricG2'
import type {SurfaceJetBoundary} from '../services/nurbsConstructors'
const props=defineProps<{label:(ru:string,en:string)=>string;locale:string;surfaces:NonNullable<DirectDocument['surfaces']>;curves:NonNullable<DirectDocument['curves']>;curveInvalid:boolean;planeInvalid:boolean;report?:G2RunoutReport}>()
const inputs=defineModel<string[]>('inputs',{required:true})
const boundary=defineModel<SurfaceJetBoundary>('boundary',{required:true})
const position=defineModel<number>('position',{required:true})
const tangentLength=defineModel<number>('tangentLength',{required:true})
const flip=defineModel<boolean>('flip',{required:true})
const reverse=defineModel<boolean>('reverse',{required:true})
const emit=defineEmits<{'length-validity':[boolean]}>()
function setInput(i:number,value:string){const next=[...inputs.value];next[i]=value;inputs.value=next}
const status=computed(()=>{
 const r=props.report;if(!r)return ''
 if(r.withinTolerance)return props.label('G2 и кривизна ≤10 мм⁻¹ подтверждены','G2 and curvature ≤10/mm confirmed')
 if(r.fields.some(f=>f.curvatureDecision==='exceeds'))return props.label('Кривизна превышает 10 мм⁻¹. Измените размер или форму перехода.','Curvature exceeds 10/mm. Change the transition size or shape.')
 if(r.seamWithinTolerance)return props.label('Кривизна или невырожденность не подтверждены. Измените параметры или повторите проверку.','Curvature or regularity unproven. Adjust parameters or retry.')
 return props.label('G2 не подтверждена. Измените параметры перехода.','G2 unproven. Adjust the transition parameters.')
})
</script>
<template>
 <section class="runout-controls">
  <small>{{ label('Создаётся отдельная переходная поверхность. Исходные поверхности сохраняются.','Creates an independent transition surface and preserves the source surfaces.') }}</small>
  <label v-for="(role,i) in [label('Исходная поверхность','Source surface'),label('Плоский торец','Planar end'),label('Граница на торце','End boundary')]" :key="role">{{ role }}<select :value="inputs[i]" @change="setInput(i,($event.target as HTMLSelectElement).value)" :aria-label="role" :aria-invalid="(i===2&&curveInvalid)||(i===1&&planeInvalid)"><template v-if="i<2"><option v-for="s in surfaces" :key="s.id" :value="s.id">{{ s.name }}</option></template><template v-else><option v-for="c in curves.filter(c=>c.curve.controlPoints[0]?.length===3)" :key="c.id" :value="c.id">{{ c.name }}</option></template></select></label>
  <label>{{ label('Край исходной поверхности','Source edge') }}<select v-model="boundary" :aria-label="label('Край исходной поверхности','Source edge')"><option v-for="b in ['uMin','uMax','vMin','vMax']" :key="b">{{ b }}</option></select></label>
  <label>{{ label('Положение шва, %','Seam position, %') }}<input v-model.number="position" type="number" min="0" max="100" step="1" :aria-label="label('Положение шва, %','Seam position, %')"></label>
  <label>{{ label('Длина касательных, мм','Tangent length, mm') }}<CadQuantityInput v-model="tangentLength" kind="length" :locale="locale" :min="0.000001" :aria-label="label('Длина касательных, мм','Tangent length, mm')" @validity="emit('length-validity',$event)" /></label>
  <label><input v-model="flip" type="checkbox">{{ label('Обратить сторону перехода','Reverse transition side') }}</label>
  <label><input v-model="reverse" type="checkbox">{{ label('Обратить направление границы','Reverse boundary direction') }}</label>
  <output v-if="report" data-testid="runout-report" aria-live="polite">{{ status }}</output>
 </section>
</template>
<style scoped>
input{color:var(--text);background:var(--surface-raised);border:1px solid var(--border);border-radius:5px;padding:7px 10px;font:inherit}
</style>
