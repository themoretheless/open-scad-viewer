<script setup lang="ts">
import { computed, onBeforeUnmount, ref, watch } from 'svet'
import { batch, signal, type Signal } from '../forma/svet'
import type { CustomizerParameter, CustomizerValue } from '../services/scadCustomizer'
import { computeBushingParameterSuggestions } from '../services/bushingGenerator'
import { computeSpinnerParameterSuggestions, type SpinnerParameterSuggestion } from '../services/spinnerGenerator'

const props = defineProps<{
  errors?: string[]
  parameters: CustomizerParameter[]
  title: string
  emptyLabel: string
}>()

const emit = defineEmits<{
  change: [name: string, value: CustomizerValue]
  batchChange: [changes: Record<string, CustomizerValue>]
}>()

const query = ref('')
const lastChangedParam = ref('')

// Svet O(1) per-parameter reactive signals for 60-120fps slider drags
const paramSignals = new Map<string, Signal<CustomizerValue>>()
const initialValues = new Map<string, CustomizerValue>()

function getParamSignal(param: CustomizerParameter): Signal<CustomizerValue> {
  let sig = paramSignals.get(param.name)
  if (!sig) {
    sig = signal(param.value)
    paramSignals.set(param.name, sig)
    if (!initialValues.has(param.name)) {
      initialValues.set(param.name, param.value)
    }
  }
  return sig
}

watch(
  () => props.parameters,
  params => {
    batch(() => {
      for (const param of params) {
        if (!initialValues.has(param.name)) {
          initialValues.set(param.name, param.value)
        }
        getParamSignal(param).set(param.value)
      }
    })
  },
  { immediate: true },
)

onBeforeUnmount(() => {
  for (const sig of paramSignals.values()) sig.dispose()
  paramSignals.clear()
})

const filteredParameters = computed(() => {
  const needle = query.value.trim().toLowerCase()
  if (!needle) return props.parameters
  return props.parameters.filter(
    p => p.name.toLowerCase().includes(needle) || p.label.toLowerCase().includes(needle),
  )
})

const selectedOptionIndexByName = computed(() => {
  const map = new Map<string, number>()
  for (const parameter of props.parameters) {
    if (parameter.options?.length) {
      map.set(parameter.name, parameter.options.indexOf(parameter.value as never))
    }
  }
  return map
})

function readParamValue(parameter: CustomizerParameter): CustomizerValue {
  return getParamSignal(parameter)()
}

function isModified(parameter: CustomizerParameter): boolean {
  const init = initialValues.get(parameter.name)
  return init !== undefined && !Object.is(init, readParamValue(parameter))
}

function resetParameter(parameter: CustomizerParameter) {
  const init = initialValues.get(parameter.name)
  if (init === undefined) return
  lastChangedParam.value = parameter.name
  getParamSignal(parameter).set(init)
  emit('change', parameter.name, init)
}

function emitNumber(name: string, event: Event) {
  const input = event.target as HTMLInputElement
  if (input.value.trim() === '' || !Number.isFinite(input.valueAsNumber)) return
  const next = input.valueAsNumber
  lastChangedParam.value = name
  paramSignals.get(name)?.set(next)
  emit('change', name, next)
}

function optionValue(parameter: CustomizerParameter, event: Event): CustomizerValue {
  const index = Number((event.target as HTMLSelectElement).value)
  const next = parameter.options?.[index] ?? parameter.value
  lastChangedParam.value = parameter.name
  paramSignals.get(parameter.name)?.set(next)
  return next
}

const parameterSuggestions = computed<SpinnerParameterSuggestion[]>(() => {
  const map: Record<string, CustomizerValue> = {}
  for (const param of props.parameters) {
    map[param.name] = readParamValue(param)
  }
  const active = lastChangedParam.value
  if ('inner_diameter' in map && 'outer_diameter' in map) {
    if (active) {
      const directBushing = computeBushingParameterSuggestions(active, map)
      if (directBushing.length > 0) return directBushing
    }
    for (const candidate of ['inner_diameter', 'outer_diameter']) {
      const fallbackBushing = computeBushingParameterSuggestions(candidate, map)
      if (fallbackBushing.length > 0) return fallbackBushing
    }
  }
  if (active) {
    const direct = computeSpinnerParameterSuggestions(active, map)
    if (direct.length > 0) return direct
  }
  for (const candidate of ['inner_radius', 'hole', 'outer_radius', 'inner_rim', 'outer_rim']) {
    const fallback = computeSpinnerParameterSuggestions(candidate, map)
    if (fallback.length > 0) return fallback
  }
  return []
})

function applySuggestion(suggestion: SpinnerParameterSuggestion) {
  batch(() => {
    for (const [name, value] of Object.entries(suggestion.changes)) {
      paramSignals.get(name)?.set(value)
    }
  })
  emit('batchChange', suggestion.changes)
}
</script>

<template>
  <section class="customizer" :aria-label="title">
    <header>
      <span>{{ title }}</span>
      <span class="count">{{ filteredParameters.length }}</span>
    </header>
    <div v-if="parameters.length > 4" class="param-search">
      <input
        v-model="query"
        type="search"
        autocomplete="off"
        placeholder="Filter parameters…"
        aria-label="Filter parameters"
      >
      <button v-if="query" type="button" class="clear-btn" aria-label="Clear filter" @click="query = ''">×</button>
    </div>
    <p v-for="(error, index) in errors" :key="index" class="validation-error" role="alert">{{ error }}</p>
    <div v-if="parameterSuggestions.length > 0" class="suggestions-box" role="region" aria-label="Предложения по пересчёту параметров">
      <div v-for="(suggestion, idx) in parameterSuggestions" :key="idx" class="suggestion-card">
        <p class="suggestion-desc">{{ suggestion.description }}</p>
        <button type="button" class="suggestion-btn" @click="applySuggestion(suggestion)">
          {{ suggestion.title }}
        </button>
      </div>
    </div>
    <p v-if="parameters.length === 0" class="empty">{{ emptyLabel }}</p>
    <div v-for="parameter in filteredParameters" :key="parameter.name" class="parameter" :class="{ modified: isModified(parameter) }">
      <label :for="`customizer-${parameter.name}`">
        <span class="label-row">
          <span>{{ parameter.label }}</span>
          <button
            v-if="isModified(parameter)"
            type="button"
            class="reset-btn"
            :title="`Reset ${parameter.name}`"
            :aria-label="`Reset ${parameter.name}`"
            @click.prevent="resetParameter(parameter)"
          >↺</button>
        </span>
        <code>{{ parameter.name }}</code>
      </label>

      <template v-if="parameter.options?.length">
        <select
          :id="`customizer-${parameter.name}`"
          :value="selectedOptionIndexByName.get(parameter.name) ?? -1"
          @change="emit('change', parameter.name, optionValue(parameter, $event))"
        >
          <option v-for="(option, index) in parameter.options" :key="`${option}`" :value="index">{{ option }}</option>
        </select>
      </template>

      <template v-else-if="typeof parameter.value === 'boolean'">
        <input
          :id="`customizer-${parameter.name}`"
          type="checkbox"
          :checked="Boolean(readParamValue(parameter))"
          @change="paramSignals.get(parameter.name)?.set(($event.target as HTMLInputElement).checked); emit('change', parameter.name, ($event.target as HTMLInputElement).checked)"
        >
      </template>

      <div v-else-if="typeof parameter.value === 'number'" class="numeric">
        <input
          v-if="parameter.min !== undefined && parameter.max !== undefined"
          :id="`customizer-${parameter.name}`"
          type="range"
          :min="parameter.min"
          :max="parameter.max"
          :step="parameter.step ?? 'any'"
          :value="readParamValue(parameter)"
          @input="emitNumber(parameter.name, $event)"
        >
        <input
          :id="parameter.min === undefined ? `customizer-${parameter.name}` : undefined"
          class="number"
          type="number"
          :min="parameter.min"
          :max="parameter.max"
          :step="parameter.step ?? 'any'"
          :value="readParamValue(parameter)"
          @input="emitNumber(parameter.name, $event)"
        >
      </div>

      <input
        v-else
        :id="`customizer-${parameter.name}`"
        type="text"
        :value="readParamValue(parameter)"
        @input="paramSignals.get(parameter.name)?.set(($event.target as HTMLInputElement).value); emit('change', parameter.name, ($event.target as HTMLInputElement).value)"
      >
    </div>
  </section>
</template>

<style scoped>
.validation-error { color: #ff8989; margin: 8px 10px; font-size: .75rem; }
.suggestions-box { display: flex; flex-direction: column; gap: 6px; padding: 8px 10px; border-bottom: 1px solid var(--border); background: color-mix(in srgb, var(--accent) 8%, transparent); }
.suggestion-card { display: flex; flex-direction: column; gap: 4px; }
.suggestion-desc { margin: 0; font-size: .66rem; color: var(--text-dim); line-height: 1.35; }
.suggestion-btn { text-align: left; padding: 5px 8px; border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--border)); border-radius: 5px; background: var(--surface-raised); color: var(--text); font-size: .68rem; font-weight: 600; cursor: pointer; line-height: 1.3; }
.suggestion-btn:hover { background: color-mix(in srgb, var(--accent) 18%, var(--surface-raised)); border-color: var(--accent); }
.customizer { min-width: 0; color: var(--text); }
header { display: flex; align-items: center; justify-content: space-between; min-height: 34px; padding: 0 10px; border-bottom: 1px solid var(--border); font-size: .72rem; font-weight: 650; letter-spacing: .02em; }
.count { min-width: 19px; padding: 1px 5px; border-radius: 999px; background: var(--hover); color: var(--text-dim); text-align: center; font-size: .62rem; }
.param-search { display: flex; align-items: center; gap: 4px; padding: 5px 10px; border-bottom: 1px solid color-mix(in srgb, var(--border) 65%, transparent); }
.param-search input { flex: 1; min-width: 0; height: 24px; padding: 2px 6px; border: 1px solid var(--border); border-radius: 5px; background: var(--surface-raised); color: var(--text); font-size: .68rem; }
.clear-btn, .reset-btn { border: 0; border-radius: 4px; background: transparent; color: var(--text-dim); cursor: pointer; padding: 0 4px; font-size: .7rem; line-height: 1; }
.clear-btn:hover, .reset-btn:hover { background: var(--hover); color: var(--accent); }
.empty { margin: 0; padding: 14px 10px; color: var(--text-dim); font-size: .69rem; line-height: 1.4; }
.parameter { display: grid; grid-template-columns: minmax(75px, .8fr) minmax(90px, 1.2fr); gap: 8px; align-items: center; padding: 7px 10px; border-bottom: 1px solid color-mix(in srgb, var(--border) 55%, transparent); }
.parameter.modified { background: color-mix(in srgb, var(--accent) 5%, transparent); }
label { min-width: 0; display: flex; flex-direction: column; gap: 2px; font-size: .69rem; }
.label-row { display: flex; align-items: center; justify-content: space-between; gap: 4px; min-width: 0; }
.label-row span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
code { color: var(--text-dim); font-size: .58rem; }
select, input[type="text"], input[type="number"] { width: 100%; min-width: 0; height: 26px; padding: 3px 6px; border: 1px solid var(--border); border-radius: 5px; background: var(--surface-raised); color: var(--text); font-size: .68rem; }
.numeric { min-width: 0; display: grid; grid-template-columns: 1fr 58px; gap: 6px; align-items: center; }
.numeric > .number:only-child { grid-column: 1 / -1; }
input[type="range"] { width: 100%; min-width: 0; accent-color: var(--accent); }
input[type="checkbox"] { width: 15px; height: 15px; accent-color: var(--accent); }
:is(input, select):focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }
</style>
