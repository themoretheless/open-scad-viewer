import {readFileSync,writeFileSync} from 'node:fs'
import {createHash} from 'node:crypto'
import assert from 'node:assert/strict'
import {encodeBinary} from '../src/services/valueBinaryCodec'
import {writeLinear,decodePacked} from '../src/services/wasmHost'
import {box3d,tetra3d} from '../tests/fixtures/minkowski3d-cases'
import {rationalRoof,constantHalf,squareParameter,retracedParameter,planarCurve,constantMultispan} from '../tests/fixtures/certified-followup-cases'
const bytes=readFileSync(process.argv[2]),w=new WebAssembly.Instance(new WebAssembly.Module(bytes)).exports as any
const proofs:any[]=[],refusals:any[]=[],calls:any[]=[]
function call(op:string,args:object):any{const start=performance.now(),request=encodeBinary({op,...args}),p=writeLinear(w.memory,w.abi_alloc,request);assert(p);try{const r=decodePacked<any>(w.memory,w.abi_free,w.abi_request(0,p,request.length));assert(r.ok,JSON.stringify(r.error));return r.value}finally{w.abi_free(p,request.length);calls.push({op,milliseconds:performance.now()-start})}}
const base=call('brep_nurbs_box',{min:[0,0,0],max:[2,2,2]}),roof=rationalRoof(base),kernel={kind:'mesh',mesh:box3d([-1,-1,-1],[1,1,1])}
for(const [name,model]of [['authored-box',base],['authored-rational-roof',roof]]as const){
 const request={a:{kind:'brep',model},b:kernel,maximumSourceDeviationMm:1,meshPrecision:'f32'},r=call('minkowski_nurbs_certify',request),verified=call('minkowski_nurbs_verify',{...request,certificate:r.certificate})
 assert(r.curvedSourceErrorCertified);assert.equal(r.roundingTopology.status,'proved');assert.equal(r.roundingTopology.precision,'f32');assert(r.sourceSurfaceDeviationMm[0]<=1);assert.deepEqual(verified.mesh,r.mesh)
 if(name==='authored-rational-roof'){assert(r.sourceSurfaceDeviationMm[0]>0);assert(r.maximumSetDeviationMm!==null&&r.maximumSetDeviationMm>0);assert.notDeepEqual(r.certificate.inner,r.certificate.outer)}else assert.equal(r.maximumSetDeviationMm,0)
 const forgeries=[];for(const mutation of ['source','continuous-bound','outer-region','depth']as const){const p=structuredClone({...request,certificate:r.certificate});if(mutation==='source')p.a.model.faces[1].surface.controlPoints[0][0][0]+=.125;else if(mutation==='continuous-bound')p.certificate.sourceHomotopyBounds[0]=['999','1'];else if(mutation==='outer-region')p.certificate.outer.triangles.pop();else p.certificate.depths[0]=4;assert.throws(()=>call('minkowski_nurbs_verify',p));forgeries.push({mutation,request:p})}
 proofs.push({name,mode:'verify-minkowski-nurbs',request:{...request,certificate:r.certificate},verified:{status:r.status,scope:r.scope,nominalVolumeMm3:r.volumeMm3,maximumSetDeviationMm:r.maximumSetDeviationMm,maximumSetDeviationExactMm:r.maximumSetDeviationExactMm,sourceSurfaceDeviationMm:r.sourceSurfaceDeviationMm,roundingTopology:r.roundingTopology},forgeries})
 console.error(name,'verified',r.sourceSurfaceDeviationMm,r.maximumSetDeviationMm)
}
{
 const request={a:tetra3d(),b:box3d([0,0,0],[1,1,1]),meshPrecision:'f32'},r=call('minkowski_3d_certify',request);assert(r.roundingTopology.wholeLinearHomotopy);assert(r.roundingTopology.pairs>0);call('minkowski_3d_verify',{...request,certificate:r.certificate})
 const forged=structuredClone({...request,certificate:r.certificate});forged.certificate.triangles.pop();assert.throws(()=>call('minkowski_3d_verify',forged));proofs.push({name:'f32-nonzero-topology',mode:'verify-minkowski-3d',request:{...request,certificate:r.certificate},verified:{status:r.status,scope:r.scope,exactVolumeMm3:r.exactVolumeMm3,roundingTopology:r.roundingTopology},forgeries:[{mutation:'boundary',request:forged}]})
}
const thin=box3d([1,0,0],[1+2**-30,1,1]);assert(call('minkowski_3d_certify',{a:thin,b:thin,meshPrecision:'f64'}).volumeMm3>0);const thinRequest={a:thin,b:thin,meshPrecision:'f32'};assert.throws(()=>call('minkowski_3d_certify',thinRequest));refusals.push({name:'f32-thin-collapse',mode:'certify-minkowski-3d',request:thinRequest})
const cylinder=call('brep_nurbs_cylinder',{radius:1,height:2});cylinder.loops[cylinder.faces[4].outer].coedges[0].pcurve.controlPoints[1][0]=2;const trimRequest={a:{kind:'brep',model:cylinder},b:kernel,maximumSourceDeviationMm:1,meshPrecision:'f32'};assert.throws(()=>call('minkowski_nurbs_certify',trimRequest));refusals.push({name:'invalid-original-trim',mode:'certify-minkowski-nurbs',request:trimRequest})
const cases=[['constant-first',constantHalf(),squareParameter(),false,1],['constant-second',squareParameter(),constantHalf(),false,1],['constant-self',constantHalf(),constantHalf(),true,1],['constant-multispan-self',constantMultispan(),constantMultispan(),true,3],['retraced-self',retracedParameter(),retracedParameter(),true,1],['different-constants',constantHalf(),planarCurve([[2,0],[2,0]]),false,0]]as const
for(const [name,first,second,selfPair,loci]of cases){const request={first,second,selfPair,maximumParameterWidth:1e-10},certificate=call('brep_curve_certify_span_intersections',request),verified=call('brep_curve_verify_span_intersections_certificate',{...request,certificate});assert.equal(verified.algebraicLoci.length,loci);assert.equal(verified.finiteEventsExhaustive,loci===0);if(name==='constant-self')assert.deepEqual(verified.stationarySpans,[[0,1]]);if(name==='constant-multispan-self'){assert(verified.algebraicLoci.every((l:any)=>l.diagonalExcluded));assert.deepEqual(verified.stationarySpans,[[0,.5],[.5,1]])}if(name==='retraced-self')assert.equal(verified.singularParameters.length,1)
 const forged=structuredClone({...request,certificate});forged.certificate.pairs=[];assert.throws(()=>call('brep_curve_verify_span_intersections_certificate',forged));proofs.push({name,mode:'verify-span-intersections',request:{...request,certificate},verified,forgeries:[{mutation:'pair-census',request:forged}]});console.error(name,'verified')}
const report={wasmSha256:createHash('sha256').update(bytes).digest('hex'),proofs,refusals,calls}
if(process.argv[4]){const mesh=call('brep_nurbs_tessellate',{model:roof,segments:2});writeFileSync(process.argv[4],JSON.stringify({version:1,sketches:[],bodies:[{id:'a',name:'Исходная NURBS-поверхность',brep:roof,mesh:{positions:Array.from(mesh.positions),indices:Array.from(mesh.indices)}},{id:'b',name:'Ядро',mesh:kernel.mesh}],curves:[],surfaces:[]},null,2)+'\n')}
writeFileSync(process.argv[3],JSON.stringify(report,null,2)+'\n')
console.log(JSON.stringify({wasmSha256:report.wasmSha256,certificates:proofs.length,forgedRejected:proofs.reduce((n,p)=>n+p.forgeries.length,0),refusals:refusals.map(p=>p.name),maxCallMs:Math.max(...calls.map(p=>p.milliseconds))},null,2))
