+        let m = vec![Q::zero(), Q::zero(), Q::one()];
+        let one = vec![Q::one()];
+        assert_eq!(
+            compare_rational(
+                &f,
+                [&n, &d],
+                &[Q::one(), q(3, 2)],
+                &g,
+                [&m, &one],
+                &[q(2, 1), q(5, 2)],
+                192,
+                64
+            )
+            .unwrap(),
+            Ordering::Equal
+        );
+    }
+}
