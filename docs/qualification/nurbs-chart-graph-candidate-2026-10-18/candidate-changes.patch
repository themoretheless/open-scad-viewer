+fn eval(poly: &p::ExactPolynomial, t: &Q) -> Q {
+    poly.iter().rev().fold(Q::zero(), |v, c| {
+        v * t + Q::new(c[0].parse().unwrap(), c[1].parse().unwrap())
+    })
+}
+fn own(a: &Curve, b: &Curve, self_pair: bool) -> p::CurveEventNodes {
