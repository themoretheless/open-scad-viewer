+fn make(
+    a: &Cell,
+    b: &Cell,
+    f: &Vec<Q>,
+    t: &Vec<Q>,
+    k: u8,
+    interval: &[Q; 2],
+    pair: usize,
+    source_cells: [usize; 2],
+    factor: Option<usize>,
+    root: usize,
+    stationary: bool,
+) -> Result<AlgebraicEventNode> {
