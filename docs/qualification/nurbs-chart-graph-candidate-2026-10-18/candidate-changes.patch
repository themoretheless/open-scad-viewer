+                    return Err(refused("Original overlap endpoint parameter census is not unique"));
+                }
+                ends.push(selected.pop().unwrap());
+            }
+            out.push((pair, ends.try_into().map_err(|_| refused("Incomplete overlap endpoints"))?));
