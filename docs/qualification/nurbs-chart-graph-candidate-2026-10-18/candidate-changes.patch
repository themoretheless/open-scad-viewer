+                raw[source].push((
+                    value(&c.exact, side),
+                    OriginalSourceCutOrigin::Common {
+                        partition,
+                        cut,
+                        side,
+                    },
+                ));
+                total += 1;
+                if total > 8192 {
+                    return Err(refused("Unified original source cut allowance exceeded"));
+                }
+            }
+        }
+    }
+    if total > 8192 {
+        return Err(refused("Unified original source cut allowance exceeded"));
+    }
+    let mut work = 0usize;
+    let mut cuts = Vec::new();
+    for input in raw {
