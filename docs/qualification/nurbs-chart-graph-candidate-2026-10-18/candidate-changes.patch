+    pub fn overlap_endpoints(&self) -> Result<Vec<(usize, [AlgebraicEventNode; 2])>> {
+        self.reverify_source()?;
+        let first = cells(&self.sources[0])?;
+        let second = cells(&self.sources[1])?;
