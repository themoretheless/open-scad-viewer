+        control_points: vec![vec![-2., 0.], vec![0., 4.], vec![2., 0.]],
+        weights: vec![1.; 3],
+        periodic: false,
+    };
+    let mut b = Curve::from_polyline(vec![vec![-3., 1.], vec![3., 1.]]).unwrap();
+    for k in &mut b.knots {
+        *k = 10. + 6. * *k;
+    }
+    let owner = own(&a, &b, false);
+    assert_eq!(owner.nodes().len(), 2);
+    for n in owner.nodes() {
+        assert!(!n.stationary);
