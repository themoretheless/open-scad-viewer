+fn output(
+    report: Report,
+    projection: Option<[[f64; 3]; 2]>,
+    parameter_scale: [f64; 2],
+) -> GluedRectangleReport {
+    GluedRectangleReport {
+        proven: report.proven,
+        projection,
+        contraction_upper: report.contraction_upper,
+        spans: report.spans,
