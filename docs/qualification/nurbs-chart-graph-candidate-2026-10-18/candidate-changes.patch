+                let mut selected = Vec::new();
+                for (i, c) in carriers
+                    .iter()
+                    .enumerate()
+                    .filter(|(_, c)| c.source == source)
+                {
+                    work += 1;
+                    if work > 262144 {
+                        return Err(refused(
+                            "Unified original common alias matching allowance exceeded",
+                        ));
+                    }
+                    if compare(&cuts[source][c.cuts[0]].value, endpoints[0], o.limits)?
