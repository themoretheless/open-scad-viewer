+            .unwrap(),
+        );
+        let x = own_original_periodic_embedding(
+            wires,
+            4096,
+            OriginalInjectiveAtlasLimits::default(),
+            OriginalAtlasPairLimits::default(),
+        )
+        .unwrap();
+        x.reverify_source().unwrap();
+        let mut bad = x.clone();
