+        let mut bad = x.clone();
+        bad.partitions[0].component = 99;
+        assert!(bad.reverify_source().is_err());
+        let mut bad = x.clone();
+        bad.edges[0].uses[0].segment = 99;
+        assert!(bad.reverify_source().is_err());
+    }
