+        .unwrap();
+        let surface = nurbs_core::surface::extrude(&c, [0., 0., 1.]).unwrap();
+        let a = Curve::from_polyline(vec![vec![0., 0.5], vec![4., 0.5]]).unwrap();
+        let pieces = Arc::new(
