+    Curve {
+        degree: 2,
+        knots: vec![0., 0., 0., 1., 1., 1.],
+        weights: vec![1.; 3],
+        control_points: if reverse {
+            vec![vec![1., 1.], vec![1., 1.], vec![1., 0.]]
+        } else {
+            vec![vec![1., 0.], vec![1., 0.], vec![1., 1.]]
+        },
+        periodic: false,
+    }
