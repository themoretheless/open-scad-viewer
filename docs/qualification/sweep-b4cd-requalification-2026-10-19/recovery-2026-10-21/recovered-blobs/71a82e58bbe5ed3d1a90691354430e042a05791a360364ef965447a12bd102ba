[package]
name = "nurbs-core"
version = "0.1.0"
edition.workspace = true
rust-version.workspace = true
publish.workspace = true

[features]
default = ["transport"]
transport = ["codec"]
codec = ["dep:value-codec", "geometry-ops/codec", "brep-topology/codec", "cad-predicates/codec"]

[dependencies]
math-core = { workspace = true }
value-codec = { workspace = true, optional = true }
geometry-ops = { workspace = true }
brep-topology = { workspace = true }
cad-predicates = { workspace = true }

