[package]
name = "polygon-core"
version = "0.1.0"
edition.workspace = true
rust-version.workspace = true
publish.workspace = true

[features]
default = ["codec"]
codec = ["dep:value-codec", "brep-topology/codec"]
gpu = ["dep:gpu-compute", "dep:compute-core"]
cuda = ["gpu", "gpu-compute/cuda", "sdf-core/cuda"]

[dependencies]
sdf-core = { workspace = true }
compute-core = { workspace = true, optional = true }
gpu-compute = { workspace = true, optional = true }
mesh-topology = { workspace = true }
manifold-core = { workspace = true }
mesh-query = { workspace = true }
mesh-section = { workspace = true }
mesh-io = { workspace = true }
math-core = { workspace = true }
value-codec = { workspace = true, optional = true }
geometry-ops = { workspace = true }
planar-geometry = { workspace = true }
brep-topology = { workspace = true }
rustc-hash = "=2.1.1"

[dev-dependencies]
rbench = { workspace = true }

[[example]]
name = "bench_mesh_kernels"
path = "examples/bench_mesh_kernels.rs"

[[example]]
name = "bench_boolean"
path = "examples/bench_boolean.rs"
