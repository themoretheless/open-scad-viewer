//! Source-bound C0 quintic tensor patches with sixth-derivative interpolation bounds.
use super::*;
use super::{
    chart::validate,
    interpolation::{NODES, Operator, operator, transform},
};
use crate::{distance_bounds::box_distance, surface::Surface};
#[derive(Clone, Debug, PartialEq)]
struct Yaw {
    period: usize,
    teeth: usize,
    cos: I,
    sin: I,
}
impl Yaw {
    fn new(period: usize, teeth: usize) -> Result<Self> {
        check(
            (12..=256).contains(&teeth) && period < teeth,
            "Nominal wheel yaw requires a valid original period/count",
        )?;
        let (sin, cos) = if period == 0 {
            (I::point(0.), I::point(1.))
        } else {
            let theta = crate::involute::certified_pi()?
                .mul(I::point(-2. * period as f64))?
                .div(I::point(teeth as f64))?;
            crate::involute::certified_trig(theta)?
        };
        Ok(Self {
            period,
            teeth,
            cos,
            sin,
        })
    }
    fn rotate(&self, p: [I; 3]) -> Result<[I; 3]> {
        Ok([
            self.cos.mul(p[0])?.sub(self.sin.mul(p[2])?)?,
            p[1],
            self.sin.mul(p[0])?.add(self.cos.mul(p[2])?)?,
        ])
    }
}
#[derive(Clone)]
enum Source {
    Original(Spec, Flank),
    Stock(StockIntersection),
    Root(RootChart),
    AxialRoot(AxialRootChart),
    AxialStock(AxialStockIntersection),
    AxialTip(AxialTipChart),
    Placed(Box<Source>, Yaw),
}
impl Source {
    fn physical_y(&self) -> bool {
        match self {
            Self::AxialRoot(_) | Self::AxialStock(_) | Self::AxialTip(_) => true,
            Self::Placed(s, _) => s.physical_y(),
            _ => false,
        }
    }

    fn spec(&self) -> Spec {
        match self {
            Self::Original(s, _) => *s,
            Self::Stock(s) => s.specification(),
            Self::Root(s) => s.specification(),
            Self::AxialRoot(s) => s.specification(),
            Self::AxialStock(s) => s.specification(),
            Self::AxialTip(s) => s.specification(),
            Self::Placed(s, _) => s.spec(),
        }
    }
    fn working_flank(&self) -> Option<Flank> {
        match self {
            Self::Original(_, f) => Some(*f),
            Self::Stock(s) => Some(s.flank()),
            Self::Root(_) | Self::AxialRoot(_) | Self::AxialTip(_) | Self::Placed(_, _) => None,
            Self::AxialStock(s) => Some(s.flank()),
        }
    }
    fn validate(&self, domain: ChartDomain) -> Result<()> {
        match self {
            Self::Original(s, f) => validate(*s, *f, domain),
            Self::Root(s) => s.validate_query(domain),
            Self::AxialRoot(s) => s.validate_query(AxialDomain {
                t: domain.u,
                y: domain.beta,
            }),
            Self::AxialStock(s) => s.validate_query(AxialDomain {
                t: domain.u,
                y: domain.beta,
            }),
            Self::AxialTip(s) => s.validate_query(AxialDomain {
                t: domain.u,
                y: domain.beta,
            }),
            Self::Placed(s, _) => s.validate(domain),
            Self::Stock(s) => {
                check(
                    s.domain().u == [0., 1.]
                        && domain.u.iter().all(|x| x.is_finite())
                        && 0. <= domain.u[0]
                        && domain.u[0] <= domain.u[1]
                        && domain.u[1] <= 1.
                        && s.domain().beta[0] <= domain.beta[0]
                        && domain.beta[0] <= domain.beta[1]
                        && domain.beta[1] <= s.domain().beta[1],
                    "Stock fit requires the full original flank, local U in [0,1] and original angles",
                )?;
                validate(
                    s.specification(),
                    s.flank(),
                    ChartDomain {
                        u: [0., 1.],
                        beta: domain.beta,
                    },
                )
            }
        }
    }
    fn replay(&self) -> Result<()> {
        match self {
            Self::Original(_, _) => Ok(()),
            Self::Stock(s) => s.reverify(),
            Self::Root(s) => s.reverify(),
            Self::AxialRoot(s) => s.reverify(),
            Self::AxialStock(s) => s.reverify(),
            Self::AxialTip(s) => s.reverify(),
            Self::Placed(s, yaw) => {
                check(
                    *yaw == Yaw::new(yaw.period, s.spec().teeth)?,
                    "Original nominal instance yaw changed",
                )?;
                s.replay()
            }
        }
    }
    fn at_beta(&self, beta: [f64; 2]) -> Result<Self> {
        match self {
            Self::Original(s, f) => Ok(Self::Original(*s, *f)),
            Self::Stock(s) => Ok(Self::Stock(s.restrict_beta(beta)?)),
            Self::AxialStock(s) => Ok(Self::AxialStock(s.restrict_y(beta)?)),
            Self::AxialTip(s) => Ok(Self::AxialTip(s.sample_y(beta)?)),
            Self::Placed(s, yaw) => Ok(Self::Placed(Box::new(s.at_beta(beta)?), yaw.clone())),
            Self::AxialRoot(s) => {
                s.validate_query(AxialDomain {
                    t: [0., 1.],
                    y: beta,
                })?;
                Ok(self.clone())
            }
            Self::Root(s) => {
                s.validate_query(ChartDomain { u: [0., 1.], beta })?;
                Ok(self.clone())
            }
        }
    }
    fn point(&self, domain: ChartDomain) -> Result<[[f64; 2]; 3]> {
        self.validate(domain)?;
        match self {
            Self::Original(s, f) => Ok(enclose_chart(*s, *f, domain)?.point()),
            Self::Root(s) => s.position_bounds(domain),
            Self::AxialRoot(s) => s.position_bounds(AxialDomain {
                t: domain.u,
                y: domain.beta,
            }),
            Self::AxialStock(s) => s.position_bounds(AxialDomain {
                t: domain.u,
                y: domain.beta,
            }),
            Self::AxialTip(s) => s.position_bounds(AxialDomain {
                t: domain.u,
                y: domain.beta,
            }),
            Self::Placed(s, yaw) => {
                let p = s.point(domain)?;
                let mut values = [I::point(0.); 3];
                for i in 0..3 {
                    values[i] = iv(p[i])?;
                }
                Ok(yaw.rotate(values)?.map(pair))
            }
            Self::Stock(s) => {
                let root = if s.domain().beta == domain.beta {
                    s.clone()
                } else {
                    s.restrict_beta(domain.beta)?
                };
                let crest = I::point(if s.flank() == Flank::Descending {
                    0.
                } else {
                    1.
                });
                let u = crest.add(iv(root.u_bracket())?.sub(crest)?.mul(iv(domain.u)?)?)?;
                Ok(enclose_chart(
                    s.specification(),
                    s.flank(),
                    ChartDomain {
                        u: [u.lo.max(0.), u.hi.min(1.)],
                        beta: domain.beta,
                    },
                )?
                .point())
            }
        }
    }
    fn cell(&self, domain: ChartDomain) -> Result<(bool, [[I; 3]; 2])> {
        self.validate(domain)?;
        match self {
            Self::Original(s, f) => Ok((
                enclose_chart(*s, *f, domain)?.regularity_proven(),
                [
                    super::taylor::sixth(*s, *f, domain, 0)?,
                    super::taylor::sixth(*s, *f, domain, 1)?,
                ],
            )),
            Self::Root(s) => {
                let r = s.enclose(domain)?;
                let mut sixth = [[I::point(0.); 3]; 2];
                for i in 0..2 {
                    for k in 0..3 {
                        sixth[i][k] = iv(r.sixth[i][k])?;
                    }
                }
                Ok((r.regularity_proven, sixth))
            }
            Self::AxialRoot(s) => {
                let r = s.enclose(AxialDomain {
                    t: domain.u,
                    y: domain.beta,
                })?;
                let mut sixth = [[I::point(0.); 3]; 2];
                for i in 0..2 {
                    for k in 0..3 {
                        sixth[i][k] = iv(r.sixth[i][k])?;
                    }
                }
                Ok((r.regularity_proven, sixth))
            }
            Self::AxialStock(s) => {
                let r = s.enclose(AxialDomain {
                    t: domain.u,
                    y: domain.beta,
                })?;
                let mut sixth = [[I::point(0.); 3]; 2];
                for i in 0..2 {
                    for k in 0..3 {
                        sixth[i][k] = iv(r.sixth[i][k])?;
                    }
                }
                Ok((r.regularity_proven, sixth))
            }
            Self::AxialTip(s) => {
                let r = s.enclose(AxialDomain {
                    t: domain.u,
                    y: domain.beta,
                })?;
                let mut sixth = [[I::point(0.); 3]; 2];
                for i in 0..2 {
                    for k in 0..3 {
                        sixth[i][k] = iv(r.sixth[i][k])?;
                    }
                }
                Ok((r.regularity_proven, sixth))
            }
            Self::Placed(s, yaw) => {
                let (regular, mut sixth) = s.cell(domain)?;
                for axis in &mut sixth {
                    *axis = yaw.rotate(*axis)?;
                }
                // Exact nominal rotation preserves ORIGINAL rank. Actual
                // saved-patch rank is still checked from actual world poles.
                Ok((regular, sixth))
            }
            Self::Stock(s) => {
                let b = s
                    .restrict_beta(domain.beta)?
                    .enclose_trimmed_chart(domain.u)?;
                let mut sixth = [[I::point(0.); 3]; 2];
                for i in 0..2 {
                    for k in 0..3 {
                        sixth[i][k] = iv(b.sixth[i][k])?;
                    }
                }
                Ok((b.regularity_proven, sixth))
            }
        }
    }
}
fn norm(v: [I; 3]) -> Result<f64> {
    let mut sum = I::point(0.);
    for x in v {
        let a = I::point(x.lo.abs().max(x.hi.abs()));
        sum = sum.add(a.mul(a)?)?;
    }
    Ok(sum.hi.max(0.).sqrt().next_up())
}
fn sixth_power(x: I) -> Result<I> {
    let xx = x.mul(x)?;
    xx.mul(xx)?.mul(xx)
}
fn node(range: [f64; 2], i: usize) -> Result<[f64; 2]> {
    if i == 0 {
        return Ok([range[0]; 2]);
    }
    if i == 5 {
        return Ok([range[1]; 2]);
    }
    let x = I::point(range[0]).add(
        I::point(range[1])
            .sub(I::point(range[0]))?
            .mul(I::point(NODES[i]))?,
    )?;
    Ok([x.lo.max(range[0]), x.hi.min(range[1])])
}
fn ideal_net(source: &Source, domain: ChartDomain, op: &Operator) -> Result<[[[I; 3]; 6]; 6]> {
    let mut samples = [[[I::point(0.); 3]; 6]; 6];
    // The implicit stock root depends on beta, not on the transverse sample.
    // Prove it once for each complete beta node box; immutable ownership keeps
    // this local reuse bound to the same original source and radius.
    for j in 0..6 {
        let beta = node(domain.beta, j)?;
        let row_source = source.at_beta(beta)?;
        for i in 0..6 {
            samples[i][j] = row_source
                .point(ChartDomain {
                    u: node(domain.u, i)?,
                    beta,
                })?
                .map(iv)
                .into_iter()
                .collect::<Result<Vec<_>>>()?
                .try_into()
                .unwrap();
        }
    }
    for row in &mut samples {
        *row = transform(row, op)?;
    }
    let mut net = samples;
    for j in 0..6 {
        let data = std::array::from_fn(|i| samples[i][j]);
        let b = transform(&data, op)?;
        for i in 0..6 {
            net[i][j] = b[i];
        }
    }
    Ok(net)
}
fn interpolation_error(sixth: [[I; 3]; 2], domain: ChartDomain, op: &Operator) -> Result<[f64; 2]> {
    let mut out = [0.; 2];
    for axis in 0..2 {
        let range = if axis == 0 { domain.u } else { domain.beta };
        let width = I::point(range[1]).sub(I::point(range[0]))?;
        let coefficient = norm(sixth[axis])?;
        out[axis] = I::point(coefficient)
            .mul(sixth_power(width)?)?
            .mul(I::point(op.weight))?
            .hi;
    }
    Ok([out[0], I::point(out[1]).mul(I::point(op.lebesgue))?.hi])
}
fn saved_regular(s: &Surface, domain: ChartDomain) -> Result<bool> {
    let mut du = [I::point(0.); 3];
    let mut db = du;
    let mut lo = [[f64::INFINITY; 3]; 2];
    let mut hi = [[f64::NEG_INFINITY; 3]; 2];
    for axis in 0..2 {
        let range = if axis == 0 { domain.u } else { domain.beta };
        let scale = I::point(5.).div(I::point(range[1]).sub(I::point(range[0]))?)?;
        for i in 0..6 {
            for j in 0..6 {
                if (axis == 0 && i == 5) || (axis == 1 && j == 5) {
                    continue;
                }
                let next = if axis == 0 {
                    &s.control_points[i + 1][j]
                } else {
                    &s.control_points[i][j + 1]
                };
                for d in 0..3 {
                    let value = I::point(next[d])
                        .sub(I::point(s.control_points[i][j][d]))?
                        .mul(scale)?;
                    lo[axis][d] = lo[axis][d].min(value.lo);
                    hi[axis][d] = hi[axis][d].max(value.hi);
                }
            }
        }
    }
    for d in 0..3 {
        du[d] = I::new(lo[0][d], hi[0][d])?;
        db[d] = I::new(lo[1][d], hi[1][d])?;
    }
    let cross = [
        du[1].mul(db[2])?.sub(du[2].mul(db[1])?)?,
        du[2].mul(db[0])?.sub(du[0].mul(db[2])?)?,
        du[0].mul(db[1])?.sub(du[1].mul(db[0])?)?,
    ];
    Ok(cross.iter().any(|x| x.lo > 0. || x.hi < 0.))
}
#[derive(Clone, Debug)]
pub struct GridCertificate {
    pub error_upper: f64,
    pub interpolation_error_upper: f64,
    pub control_difference_upper: f64,
    pub directional_error_upper: [f64; 2],
    pub source_regular: bool,
    pub saved_regular: bool,
    pub patches: usize,
}
fn validate_layout(
    domain: ChartDomain,
    u: &[f64],
    b: &[f64],
    surface_count: usize,
    max_patches: usize,
) -> Result<()> {
    check(
        u.len() >= 2
            && b.len() >= 2
            && u.len() <= 4097
            && b.len() <= 4097
            && u.first() == Some(&domain.u[0])
            && u.last() == Some(&domain.u[1])
            && b.first() == Some(&domain.beta[0])
            && b.last() == Some(&domain.beta[1])
            && u.iter().chain(b).all(|x| x.is_finite())
            && u.windows(2).all(|x| x[0] < x[1])
            && b.windows(2).all(|x| x[0] < x[1])
            && (1..=4096).contains(&max_patches)
            && (u.len() - 1) * (b.len() - 1) == surface_count
            && surface_count <= max_patches,
        "Wheel NURBS grid must cover the original rectangle with a complete bounded patch census",
    )
}
fn verify(
    source: &Source,
    domain: ChartDomain,
    u: &[f64],
    b: &[f64],
    surfaces: &[Surface],
    max_patches: usize,
    op: &Operator,
) -> Result<GridCertificate> {
    source.validate(domain)?;
    source.replay()?;
    validate_layout(domain, u, b, surfaces.len(), max_patches)?;
    let nb = b.len() - 1;
    let mut report = GridCertificate {
        error_upper: 0.,
        interpolation_error_upper: 0.,
        control_difference_upper: 0.,
        directional_error_upper: [0.; 2],
        source_regular: true,
        saved_regular: true,
        patches: surfaces.len(),
    };
    for (i, s) in surfaces.iter().enumerate() {
        let iu = i / nb;
        let ib = i % nb;
        let cell = ChartDomain {
            u: [u[iu], u[iu + 1]],
            beta: [b[ib], b[ib + 1]],
        };
        s.validate()?;
        let ku = [vec![cell.u[0]; 6], vec![cell.u[1]; 6]].concat();
        let kb = [vec![cell.beta[0]; 6], vec![cell.beta[1]; 6]].concat();
        check(
            s.degree_u == 5
                && s.degree_v == 5
                && s.knots_u == ku
                && s.knots_v == kb
                && !s.periodic_u
                && !s.periodic_v
                && s.control_points.len() == 6
                && s.control_points
                    .iter()
                    .all(|r| r.len() == 6 && r.iter().all(|p| p.len() == 3))
                && s.weights.iter().flatten().all(|w| *w == 1.),
            "Wheel fit requires original quintic tensor Bernstein patches and exact source domains",
        )?;
        if source.physical_y() {
            let values = physical_y_controls(cell.beta)?;
            check(
                s.control_points.iter().all(|row| {
                    row.iter()
                        .zip(values)
                        .all(|(p, y)| p[1].to_bits() == y.to_bits())
                }),
                "Axial grid lost its canonical physical-Y controls or end planes",
            )?;
        }
        let (regular, sixth) = source.cell(cell)?;
        report.source_regular &= regular;
        report.saved_regular &= saved_regular(s, cell)?;
        let ideal = ideal_net(source, cell, op)?;
        let mut delta = 0_f64;
        for j in 0..6 {
            for k in 0..6 {
                let actual = s.control_points[j][k]
                    .iter()
                    .map(|x| I::point(*x))
                    .collect::<Vec<_>>();
                delta = delta.max(box_distance(&actual, &ideal[j][k])?.1);
            }
        }
        let terms = interpolation_error(sixth, cell, op)?;
        let remainder = I::point(terms[0]).add(I::point(terms[1]))?.hi;
        report.control_difference_upper = report.control_difference_upper.max(delta);
        report.interpolation_error_upper = report.interpolation_error_upper.max(remainder);
        for d in 0..2 {
            report.directional_error_upper[d] = report.directional_error_upper[d].max(terms[d]);
        }
        report.error_upper = report
            .error_upper
            .max(I::point(remainder).add(I::point(delta))?.hi);
        if iu > 0 {
            let previous = &surfaces[(iu - 1) * nb + ib];
            check(
                previous.control_points[5] == s.control_points[0],
                "Wheel NURBS U seam differs in actual original controls",
            )?;
        }
        if ib > 0 {
            let previous = &surfaces[i - 1];
            check(
                (0..6).all(|j| previous.control_points[j][5] == s.control_points[j][0]),
                "Wheel NURBS beta seam differs in actual original controls",
            )?;
        }
    }
    Ok(report)
}
/// Independent continuous original-envelope error and actual C0 grid replay.
/// Source and saved-patch regularity are separate, independently recomputed flags.
pub fn certify_envelope_grid(
    spec: Spec,
    flank: Flank,
    domain: ChartDomain,
    u: &[f64],
    beta: &[f64],
    surfaces: &[Surface],
    max_patches: usize,
) -> Result<GridCertificate> {
    verify(
        &Source::Original(spec, flank),
        domain,
        u,
        beta,
        surfaces,
        max_patches,
        &operator()?,
    )
}
fn breaks(range: [f64; 2], n: usize) -> Vec<f64> {
    (0..=n)
        .map(|i| {
            if i == 0 {
                range[0]
            } else if i == n {
                range[1]
            } else {
                range[0] + (range[1] - range[0]) * (i as f64 / n as f64)
            }
        })
        .collect()
}
// Nominal parameter V is physical Y. The saved polynomial may differ from
// exact identity by rounding of the interior 1/5 controls; that error is
// included in the ordinary actual-control/source bound. End planes are exact.
fn physical_y_controls(y: [f64; 2]) -> Result<[f64; 6]> {
    let mut values = [0.; 6];
    values[0] = y[0];
    values[5] = y[1];
    for i in 1..5 {
        values[i] = mid(I::point(y[0]).add(
            I::point(y[1])
                .sub(I::point(y[0]))?
                .mul(I::point(i as f64).div(I::point(5.))?)?,
        )?);
    }
    check(
        values.windows(2).all(|w| w[0] < w[1]),
        "Axial Y controls lost strict parameter progress",
    )?;
    Ok(values)
}
fn build(source: &Source, u: &[f64], beta: &[f64], op: &Operator) -> Result<Vec<Surface>> {
    let mut surfaces = Vec::new();
    for a in u.windows(2) {
        for b in beta.windows(2) {
            let domain = ChartDomain {
                u: [a[0], a[1]],
                beta: [b[0], b[1]],
            };
            let net = ideal_net(source, domain, op)?;
            let mut s = Surface {
                degree_u: 5,
                degree_v: 5,
                knots_u: [vec![a[0]; 6], vec![a[1]; 6]].concat(),
                knots_v: [vec![b[0]; 6], vec![b[1]; 6]].concat(),
                periodic_u: false,
                periodic_v: false,
                control_points: net
                    .into_iter()
                    .map(|row| row.into_iter().map(|p| p.map(mid).to_vec()).collect())
                    .collect(),
                weights: vec![vec![1.; 6]; 6],
            };
            if source.physical_y() {
                let values = physical_y_controls(domain.beta)?;
                for row in &mut s.control_points {
                    for (p, y) in row.iter_mut().zip(values) {
                        p[1] = y;
                    }
                }
            }
            s.validate()?;
            surfaces.push(s);
        }
    }
    Ok(surfaces)
}
fn pack(surfaces: &[Surface], u: &[f64], beta: &[f64]) -> Result<Vec<Surface>> {
    let nu = u.len() - 1;
    let nb = beta.len() - 1;
    let mut out = Vec::new();
    for first in (0..nu).step_by(6) {
        for start in (0..nb).step_by(6) {
            let last = (first + 6).min(nu);
            let end = (start + 6).min(nb);
            let mut ku = vec![u[first]; 6];
            for &x in &u[first + 1..last] {
                ku.extend(std::iter::repeat_n(x, 5));
            }
            ku.extend(std::iter::repeat_n(u[last], 6));
            let mut kb = vec![beta[start]; 6];
            for &x in &beta[start + 1..end] {
                kb.extend(std::iter::repeat_n(x, 5));
            }
            kb.extend(std::iter::repeat_n(beta[end], 6));
            let rows = 5 * (last - first) + 1;
            let cols = 5 * (end - start) + 1;
            let mut points = Vec::new();
            for r in 0..rows {
                let (i, ri) = if r == rows - 1 {
                    (last - 1, 5)
                } else {
                    (first + r / 5, r % 5)
                };
                let mut row = Vec::new();
                for c in 0..cols {
                    let (j, cj) = if c == cols - 1 {
                        (end - 1, 5)
                    } else {
                        (start + c / 5, c % 5)
                    };
                    row.push(surfaces[i * nb + j].control_points[ri][cj].clone());
                }
                points.push(row);
            }
            let s = Surface {
                degree_u: 5,
                degree_v: 5,
                knots_u: ku,
                knots_v: kb,
                control_points: points,
                weights: vec![vec![1.; cols]; rows],
                periodic_u: false,
                periodic_v: false,
            };
            s.validate()?;
            out.push(s);
        }
    }
    Ok(out)
}

struct QualifiedGrid {
    source: Source,
    domain: ChartDomain,
    u: Vec<f64>,
    beta: Vec<f64>,
    surfaces: Vec<Surface>,
    packed: Vec<Surface>,
    certificate: GridCertificate,
    tolerance: f64,
}
fn same_scalar_bits(a: &[f64], b: &[f64]) -> bool {
    a.len() == b.len() && a.iter().zip(b).all(|(x, y)| x.to_bits() == y.to_bits())
}
fn same_row_bits(a: &[Vec<f64>], b: &[Vec<f64>]) -> bool {
    a.len() == b.len() && a.iter().zip(b).all(|(x, y)| same_scalar_bits(x, y))
}
fn same_packed_definitions(a: &[Surface], b: &[Surface]) -> bool {
    a.len() == b.len()
        && a.iter().zip(b).all(|(x, y)| {
            x.degree_u == y.degree_u
                && x.degree_v == y.degree_v
                && x.periodic_u == y.periodic_u
                && x.periodic_v == y.periodic_v
                && same_scalar_bits(&x.knots_u, &y.knots_u)
                && same_scalar_bits(&x.knots_v, &y.knots_v)
                && same_row_bits(&x.weights, &y.weights)
                && x.control_points.len() == y.control_points.len()
                && x.control_points
                    .iter()
                    .zip(&y.control_points)
                    .all(|(p, q)| same_row_bits(p, q))
        })
}
impl QualifiedGrid {
    fn reverify_against(&self, source: &Source) -> Result<()> {
        check(
            same_packed_definitions(&pack(&self.surfaces, &self.u, &self.beta)?, &self.packed),
            "Owned wheel packed control/weight/knot definitions changed",
        )?;
        let fresh = verify(
            source,
            self.domain,
            &self.u,
            &self.beta,
            &self.surfaces,
            self.surfaces.len(),
            &operator()?,
        )?;
        check(
            fresh.error_upper <= self.tolerance
                && fresh.source_regular
                && fresh.saved_regular
                && fresh.error_upper == self.certificate.error_upper,
            "Owned wheel source/grid error receipt changed",
        )
    }
}
