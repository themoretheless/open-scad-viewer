{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-scad-viewer.invalid/schemas/brep-capability-qualification-plan-v2.schema.json",
  "title": "B-rep dependency-aware capability qualification plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "schemaVersion",
    "planId",
    "gate",
    "lifecycle",
    "claimBoundary",
    "capability",
    "dependencies",
    "scope",
    "matrix",
    "bindings",
    "evidence",
    "resetPolicy",
    "unresolvedRows"
  ],
  "properties": {
    "$schema": {
      "const": "./brep-capability-qualification-plan-v2.schema.json"
    },
    "schema": {
      "const": "open-scad-viewer/brep-capability-qualification-plan"
    },
    "schemaVersion": {
      "const": 2
    },
    "planId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "const": "g8-full" },
        "name": { "const": "brep-full-closed-matrix" },
        "version": { "const": 2 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "qualificationClaim"],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "frozen-pending-execution",
            "executing",
            "qualified",
            "rejected",
            "stale",
            "superseded"
          ]
        },
        "qualificationClaim": {
          "enum": ["none", "walking-slice", "qualified"]
        }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateClaim", "forbiddenClaims"],
      "properties": {
        "candidateClaim": { "type": "string", "minLength": 1 },
        "forbiddenClaims": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[1-9][0-9]*$"
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "requiredMaturity"],
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[1-9][0-9]*$"
          },
          "requiredMaturity": { "const": "Qualified" }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "excluded": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expected", "blocksQualification"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "expected": {
            "enum": ["Complete", "typed-refuse", "ResearchOnly"]
          },
          "blocksQualification": { "type": "boolean" }
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "registry", "evidenceJson"],
      "properties": {
        "implementation": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "registry": {
          "const": "src/services/geometry/brepCapability.ts"
        },
        "evidenceJson": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "notes"],
      "properties": {
        "state": {
          "enum": ["not-executed", "executing", "qualified", "rejected", "stale"]
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "resetPolicy": {
      "const": "false-Complete freezes this capability and transitively stales all dependents; recovery requires a successor capability ID"
    },
    "unresolvedRows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "resolution"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["open", "accepted-risk", "closed"] },
          "resolution": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
