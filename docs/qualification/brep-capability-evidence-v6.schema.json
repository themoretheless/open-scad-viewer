{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-scad-viewer.invalid/schemas/brep-capability-evidence-v6.schema.json",
  "title": "Append-only B-rep successor capability evidence v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema", "schemaVersion", "evidenceId", "capability",
    "maturity", "state", "plan", "runs", "oracles", "unresolvedRows",
    "attestation"
  ],
  "properties": {
    "$schema": { "const": "./brep-capability-evidence-v6.schema.json" },
    "schema": { "const": "open-scad-viewer/brep-capability-evidence" },
    "schemaVersion": { "const": 6 },
    "evidenceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-evidence-v6$"
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*/[1-9][0-9]*$"
    },
    "maturity": {
      "enum": ["Unavailable", "ResearchOnly", "NumericUncertified", "AnalyticComplete", "Qualified"]
    },
    "state": {
      "enum": ["not-executed", "executing", "qualified", "rejected", "stale"]
    },
    "plan": { "type": "string", "minLength": 1 },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "result", "artifactHash"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail", "indeterminate"] },
          "artifactHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "oracles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "unresolvedRows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "resolution"],
        "properties": {
          "id": { "type": "string", "pattern": "^NB8-[A-Z0-9-]+$" },
          "status": { "enum": ["open", "accepted-risk", "closed"] },
          "resolution": { "type": "string", "minLength": 1 }
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fabricatedRuns", "note"],
      "properties": {
        "fabricatedRuns": { "const": false },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "state": { "const": "qualified" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "maturity": { "const": "Qualified" },
          "runs": { "type": "array", "minItems": 1 },
          "oracles": { "type": "array", "minItems": 1 },
          "unresolvedRows": { "type": "array", "maxItems": 0 }
        }
      }
    },
    {
      "if": {
        "properties": { "state": { "const": "not-executed" } },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "maturity": { "const": "Unavailable" },
          "runs": { "type": "array", "maxItems": 0 },
          "oracles": { "type": "array", "maxItems": 0 },
          "unresolvedRows": { "type": "array", "minItems": 1 }
        }
      }
    }
  ]
}
