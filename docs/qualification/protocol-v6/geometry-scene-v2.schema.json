{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-scad-viewer.invalid/schemas/geometry-scene-v2.schema.json",
  "title": "GeometrySceneV2 (future G4a publication)",
  "description": "G0.8 IDL freeze for the future publication envelope. Not the current Worker success payload.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schemaVersion",
    "protocolVersion",
    "workerEpoch",
    "kernelKey",
    "kernelFingerprint",
    "capabilityManifestVersion",
    "topologySnapshotId",
    "meshAssetIds",
    "fullEquivalent",
    "reduced",
    "occurrences",
    "assets",
    "diagnostics"
  ],
  "properties": {
    "schema": { "const": "open-scad-viewer/geometry-scene-v2" },
    "schemaVersion": { "const": 1 },
    "protocolVersion": { "type": "integer", "const": 6 },
    "workerEpoch": { "type": "integer", "minimum": 0 },
    "kernelKey": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kernelFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capabilityManifestVersion": { "type": "integer", "minimum": 1 },
    "topologySnapshotId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "meshAssetIds": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "fullEquivalent": { "type": "boolean" },
    "reduced": { "type": "boolean" },
    "representation": {
      "type": "string",
      "enum": ["mesh", "brep", "mixed-terminal-mesh"]
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["occurrenceId", "assetIndex", "transform"],
        "properties": {
          "occurrenceId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "assetIndex": { "type": "integer", "minimum": 0 },
          "transform": {
            "type": "array",
            "minItems": 16,
            "maxItems": 16,
            "items": { "type": "number" }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["meshAssetId", "vertexBytes", "indexBytes"],
        "properties": {
          "meshAssetId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "vertexBytes": { "type": "integer", "minimum": 0 },
          "indexBytes": { "type": "integer", "minimum": 0 },
          "packetTopoTokens": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 128 },
          "message": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positionalBound": { "type": "number" },
        "topologyPreservation": { "type": "boolean" }
      }
    }
  }
}
