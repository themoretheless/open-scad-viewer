{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "jsx": "preserve",
    "importHelpers": false,
    "allowJs": true,
    "sourceMap": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["@webgpu/types"],
    "paths": {
      "vue": ["./src/forma/svet-runtime.ts"],
      "@vue/server-renderer": ["./src/forma/svet-runtime.ts"],
      "svet": ["./src/forma/svet-runtime.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svt", "env.d.ts"],
  "exclude": ["src/mcp/**"]
}
